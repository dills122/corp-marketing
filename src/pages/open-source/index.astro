---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  contributionCount,
  contributionsVerifiedAt,
  openSourceProjects,
  repositoryCount,
} from "../../data/open-source";

const formatDate = (date: string) => new Intl.DateTimeFormat("en", {
  month: "short", day: "numeric", year: "numeric", timeZone: "UTC",
}).format(new Date(`${date}T00:00:00Z`));
const contributionYears = (dates: string[]) => {
  const years = dates.map((date) => Number(date.slice(0, 4)));
  const first = Math.min(...years);
  const last = Math.max(...years);
  return first === last ? String(first) : `${first}–${last}`;
};
---

<BaseLayout
  title="Open source | Shwimp Studios"
  description="Selected open-source contributions by Dylan Steele: merged fixes, compatibility improvements, and tooling for LLRT, rusty_v8, image-hash, Taho, and React Spark."
  canonicalPath="/open-source/"
>
  <main id="main-content">
    <header class="contribution-hero">
      <div class="hero-inner">
        <div class="hero-title" data-reveal>
          <p class="eyebrow">Giving back</p>
          <h1>Open<br />source.</h1>
        </div>
        <div class="hero-intro" data-reveal data-reveal-delay="1">
          <p>Here are some of our contributions to other open-source projects. They include bug fixes,
            Linux build support, and changes to libraries and interfaces. The merged pull requests are linked below.</p>
          <dl class="totals" aria-label="Selected contribution totals">
            <div><dt>Merged PRs</dt><dd>{contributionCount}</dd></div>
            <div><dt>Projects</dt><dd>{openSourceProjects.length}</dd></div>
            <div><dt>Repositories</dt><dd>{repositoryCount}</dd></div>
          </dl>
        </div>
      </div>
      <nav class="project-index" aria-label="Contribution projects">
        {openSourceProjects.map((project) => <a href={`#${project.slug}`}>{project.name}<span aria-hidden="true">↓</span></a>)}
      </nav>
    </header>

    <div class="provenance">
      <p>Contributions by <a href="https://github.com/dills122">Dylan Steele / dills122 ↗</a>,
        including work from before the studio.</p>
      <p>Verified <time datetime={contributionsVerifiedAt}>{formatDate(contributionsVerifiedAt)}</time></p>
    </div>

    <div class="contribution-register">
      {openSourceProjects.map((project) => (
        <section class="contribution-project" id={project.slug} aria-labelledby={`${project.slug}-title`}>
          <div class="project-identity">
            <p class="project-kind">{project.kind}</p>
            <h2 id={`${project.slug}-title`}>{project.name}</h2>
            <strong class="merge-badge">{project.contributions.length} merged {project.contributions.length === 1 ? "PR" : "PRs"}</strong>
            <p class="project-period">{contributionYears(project.contributions.map((pr) => pr.mergedAt))}

            </p>
          </div>
          <div class="project-work">
            <h3>{project.headline}</h3>
            <p class="project-summary">{project.summary}</p>
            {project.continuation && (
              <a class="continuation-link" href={project.continuation.href} target="_blank" rel="noopener noreferrer">
                {project.continuation.label} <span aria-hidden="true">↗</span>
              </a>
            )}
            <details>
              <summary>
                <span>View merged PRs</span>
                <span class="detail-indicator" aria-hidden="true">+</span>
              </summary>
              <ul class="pr-list">
                {project.contributions.map((pr) => (
                  <li>
                    <a href={pr.url} target="_blank" rel="noopener noreferrer">
                      <span class="pr-title">{pr.title} <span aria-hidden="true">↗</span></span>
                      <span class="pr-repository">{pr.repository} #{pr.number}</span>
                    </a>
                    <span class="pr-date">Merged <time datetime={pr.mergedAt}>{formatDate(pr.mergedAt)}</time></span>
                  </li>
                ))}
              </ul>
            </details>
          </div>
        </section>
      ))}
    </div>

    <aside class="closing-note" aria-label="About this selection">
      <div>
        <h2>The pull requests<br />are linked above.</h2>
        <p>Each link shows what changed and when the project’s maintainers merged it.
          We update this list by hand, so newer contributions may not be here yet.</p>
      </div>
      <a href="/projects/">See our projects <span aria-hidden="true">→</span></a>
    </aside>
  </main>
</BaseLayout>

<style>
  /* Hallmark · macrostructure: Catalogue · tone: studio editorial · anchor hue: warm orange
   * Theme: existing Shwimp site; catalog hero, display type, badges, and ruled rows.
   * User-directed consistency overrides theme rotation. Enrichment: none.
   * Pre-emit critique: P4 H4 E4 S5 R5 V4 */
  :global(html), :global(body) { overflow-x: clip; }
  h1, h2, h3, p, dl, dd { margin-top: 0; }
  h1, h2, h3 { min-width: 0; overflow-wrap: anywhere; text-wrap: balance; }
  .hero-inner, .project-index, .provenance, .contribution-register, .closing-note {
    width: min(100%, var(--max)); margin-inline: auto;
  }
  .eyebrow, .project-index, .project-kind, .merge-badge, .project-period, summary,
  .pr-repository, .pr-date, .closing-note > a {
    font-family: var(--font-label); font-size: 0.7rem; font-weight: 800;
    letter-spacing: 0.06em; text-transform: uppercase;
  }
  .contribution-hero {
    --hero-muted: color-mix(in srgb, var(--paper-strong) 72%, var(--ink-deep));
    --hero-line: color-mix(in srgb, var(--paper-strong) 32%, var(--ink-deep));
    color: var(--paper-strong); background: var(--ink-deep);
  }
  .hero-inner {
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(330px, 0.65fr);
    gap: clamp(44px, 8vw, 120px); align-items: end;
    padding: clamp(58px, 7vw, 94px) var(--gutter);
  }
  .eyebrow { margin-bottom: var(--space-md); color: var(--reef); }
  h1 {
    margin-bottom: 0; font-family: var(--font-display); font-size: var(--text-page);
    letter-spacing: -0.075em; line-height: 0.84;
  }
  .hero-intro { padding-top: var(--space-md); border-top: 1px solid var(--hero-line); }
  .hero-intro > p { margin-bottom: 32px; color: var(--hero-muted); font-family: var(--font-editorial); font-size: 1.14rem; line-height: 1.5; }
  .totals { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-bottom: 0; background: var(--hero-line); }
  .totals div { padding: 12px; background: var(--ink-deep); }
  .totals dt { color: var(--hero-muted); font-family: var(--font-label); font-size: 0.65rem; font-weight: 800; text-transform: uppercase; }
  .totals dd { margin: 0; font-family: var(--font-display); font-size: 1.65rem; line-height: 1.1; }
  .project-index { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--hero-line); border-left: 1px solid var(--hero-line); }
  .project-index a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 58px; padding: 16px 24px; border-right: 1px solid var(--hero-line); white-space: nowrap; }
  .project-index a:hover, .project-index a:focus-visible { color: var(--ink-deep); background: var(--reef); }
  .project-index span { transition: transform var(--motion-fast) var(--ease-out); }
  .project-index a:hover span { transform: translateY(3px); }
  .provenance { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-sm) var(--space-lg); padding: var(--space-lg) var(--gutter); color: var(--ink-soft); font-size: 0.85rem; }
  .provenance p { margin-bottom: 0; }
  .provenance a { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  .contribution-register { padding: 0 var(--gutter) var(--space-xl); }
  .contribution-project {
    display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(32px, 6vw, 88px); padding: var(--space-lg) 16px var(--space-lg) 0;
    border-bottom: 1px solid var(--line-strong);
    scroll-margin-top: calc(var(--header-offset) + 16px);
  }
  .contribution-project:first-child { border-top: 2px solid var(--ink-deep); }
  .contribution-project:hover, .contribution-project:focus-within { background: color-mix(in srgb, var(--reef) 10%, transparent); }
  .project-kind { margin-bottom: var(--space-xs); color: var(--ink-soft); }
  .project-identity h2 { margin: 0 0 var(--space-sm); font-family: var(--font-display); font-size: clamp(2rem, 3.1vw, 3.5rem); letter-spacing: -0.075em; line-height: 0.86; }
  .merge-badge { display: inline-block; padding: 4px 7px; color: var(--ink-deep); background: var(--reef); }
  .project-period { margin: var(--space-sm) 0 0; color: var(--ink-soft); }
  h3 { margin-bottom: 10px; color: var(--ink-deep); font-family: var(--font-editorial); font-size: 1.15rem; font-weight: 700; line-height: 1.3; }
  .project-summary { margin-bottom: var(--space-md); color: var(--ink-soft); }
  details { border-top: 1px solid var(--line); }
  .continuation-link { display: inline-flex; align-items: center; gap: var(--space-sm); min-height: 44px; margin-bottom: var(--space-md); border-bottom: 1px solid var(--line-strong); font-family: var(--font-label); font-size: 0.7rem; font-weight: 800; text-transform: uppercase; }
  .continuation-link:hover, .continuation-link:focus-visible { color: var(--accent-dark); border-color: var(--accent); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: var(--space-sm); min-height: 48px; cursor: pointer; list-style: none; white-space: nowrap; }
  summary::-webkit-details-marker { display: none; }
  summary:hover, summary:focus-visible, .provenance a:hover, .provenance a:focus-visible { color: var(--accent-dark); }
  .detail-indicator { font-size: 1.3rem; transition: transform var(--motion-fast) var(--ease-out); }
  details[open] .detail-indicator { transform: rotate(45deg); }
  .pr-list { padding: 0; margin: 0; list-style: none; }
  .pr-list li { padding-block: var(--space-sm); border-top: 1px solid var(--line); }
  .pr-list a { display: grid; gap: 5px; padding-block: 4px; }
  .pr-list a:hover, .pr-list a:focus-visible { color: var(--accent-dark); }
  .pr-title { font-size: 0.95rem; font-weight: 650; overflow-wrap: anywhere; }
  .pr-repository { color: var(--ink-soft); overflow-wrap: anywhere; text-transform: none; letter-spacing: 0; }
  .pr-date { display: block; margin-top: 4px; color: var(--ink-soft); font-size: 0.65rem; }
  .closing-note { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--space-lg); padding: 0 var(--gutter) var(--section-space); }
  .closing-note div { max-width: 650px; }
  .closing-note h2 { margin-bottom: var(--space-md); font-family: var(--font-display); font-size: clamp(2rem, 3vw, 3rem); line-height: 0.9; letter-spacing: -0.065em; }
  .closing-note p { margin-bottom: 0; color: var(--ink-soft); }
  .closing-note > a { display: inline-flex; gap: var(--space-md); align-items: center; min-height: 48px; border-bottom: 2px solid var(--ink-deep); white-space: nowrap; }
  .closing-note > a:hover, .closing-note > a:focus-visible { color: var(--accent-dark); border-color: var(--accent); }
  @media (max-width: 1000px) {
    .hero-inner { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .hero-intro { max-width: 650px; }
    .project-index a { padding-inline: 16px; font-size: 0.65rem; }
  }
  @media (max-width: 760px) {
    .hero-inner { padding-block: 42px 38px; }
    .eyebrow { margin-bottom: 17px; }
    h1 { font-size: clamp(3rem, 15vw, 4.7rem); }
    .hero-intro { padding-top: 20px; }
    .hero-intro > p { margin-bottom: 23px; font-size: 1rem; }
    .project-index { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .project-index a { min-height: 52px; padding: 13px 16px; border-bottom: 1px solid var(--hero-line); }
    .project-index a:last-child { grid-column: 1 / -1; }
    .provenance { padding-block: var(--space-md); gap: var(--space-xs); }
    .contribution-project { grid-template-columns: minmax(0, 1fr); gap: var(--space-md); padding: 28px 0; }
    .project-identity h2 { font-size: clamp(2.15rem, 11vw, 3.25rem); }
    .project-period { display: inline-block; margin: 0 0 0 12px; }
    .closing-note { grid-template-columns: minmax(0, 1fr); }
    .closing-note > a { justify-self: start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .detail-indicator, .project-index span { transition: none; }
    .project-index a:hover span { transform: none; }
  }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ecosystem, projects } from "../../data/site";

const orgCards = ecosystem.map((org, index) => {
  const orgProjects = org.name === "Lady International" ? projects : projects.filter((project) => project.division === org.name);
  return {
    ...org,
    number: String(index + 1).padStart(2, "0"),
    currentCount: orgProjects.filter((project) => project.phase !== "past").length,
    pastCount: orgProjects.filter((project) => project.phase === "past").length,
  };
});
---

<BaseLayout
  title="Organizations | Shwimp Studios"
  description="Organizations in the Lady International and Shwimp Studios ecosystem."
  canonicalPath="/org/"
>
  <main id="main-content">
    <header class="directory-hero" aria-labelledby="directory-title">
      <div class="hero-inner">
        <a class="back-link" href="/"><span aria-hidden="true">←</span> Shwimp Studios</a>
        <p class="eyebrow">The label family · Five names with actual jobs</p>
        <h1 id="directory-title">A small corporate universe.</h1>
        <div class="hero-note">
          <p>
            One parent organization and four operating imprints for products, engineering, publishing, and exploratory
            ventures. Because apparently one company name was not enough.
          </p>
          <span>Est. whenever this seemed like a good idea</span>
        </div>
      </div>
    </header>

    <section class="directory" aria-labelledby="family-title">
      <div class="directory-heading">
        <div>
          <p class="eyebrow">Organization catalogue</p>
          <h2 id="family-title">Choose an imprint.</h2>
        </div>
        <p>Counts reflect public work only. Private projects may be absent, classified, or still too vague to name.</p>
      </div>

      <div class="organization-list">
        {
          orgCards.map((org, index) => (
            <a class={`organization org-${index}`} href={`/org/${org.slug}/`}>
              <div class="org-number"><span>{org.number}</span><small>{org.role}</small></div>
              <div class="org-name">
                <p>{org.name.slice(0, 1)}</p>
                <h3>{org.name}</h3>
              </div>
              <p class="org-description">{org.description}</p>
              <dl>
                <div><dt>Current</dt><dd>{org.currentCount}</dd></div>
                <div><dt>Past</dt><dd>{org.pastCount}</dd></div>
              </dl>
              <span class="org-arrow" aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, h3 { text-wrap: balance; }

  .eyebrow,
  .back-link,
  .hero-note span,
  .org-number,
  dt,
  .org-arrow {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .directory-hero { color: var(--paper-strong); background: var(--ink-deep); }
  .hero-inner, .directory-heading, .organization-list { width: min(100%, var(--max)); margin-inline: auto; }
  .hero-inner { padding: clamp(52px, 7vw, 92px) var(--gutter) clamp(58px, 7vw, 98px); }
  .back-link { display: inline-flex; gap: 10px; align-items: center; min-height: 44px; margin-bottom: clamp(34px, 5vw, 62px); color: var(--reef); }
  .back-link:hover, .back-link:focus-visible { color: var(--accent); }
  .eyebrow { margin-bottom: var(--space-md); color: var(--accent); }
  h1 { max-width: 1120px; margin-bottom: clamp(36px, 5vw, 58px); font-family: var(--font-display); font-size: var(--text-page); letter-spacing: -0.08em; line-height: 0.86; }
  .hero-note { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 40px; align-items: end; padding-top: var(--space-lg); border-top: 1px solid rgba(255,255,255,0.3); }
  .hero-note p { max-width: 760px; margin: 0; color: rgba(255,255,255,0.7); font-family: var(--font-editorial); font-size: clamp(1.12rem, 2vw, 1.5rem); }
  .hero-note span { color: var(--trove); }

  .directory { padding: var(--section-space) var(--gutter); }
  .directory-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 0.5fr); gap: clamp(40px, 8vw, 110px); align-items: end; margin-bottom: var(--space-xl); }
  .directory-heading h2 { margin: 0; font-family: var(--font-display); font-size: var(--text-section); letter-spacing: -0.07em; line-height: 0.88; }
  .directory-heading > p { margin: 0; color: var(--ink-soft); font-family: var(--font-editorial); font-size: 1.1rem; }

  .organization-list { border-top: 1px solid var(--line-strong); }
  .organization { position: relative; display: grid; grid-template-columns: 100px minmax(230px, 0.8fr) minmax(280px, 1fr) 125px; gap: clamp(20px, 3vw, 48px); align-items: center; min-height: 210px; padding: clamp(24px, 3vw, 38px) 64px clamp(24px, 3vw, 38px) 16px; border-bottom: 1px solid var(--line-strong); transition: color 150ms ease, background 150ms ease; }
  .org-number { display: grid; align-self: start; gap: 6px; color: var(--ink-soft); }
  .org-number span { color: var(--accent-dark); font-family: var(--font-display); font-size: 2rem; letter-spacing: -0.05em; }
  .org-name { position: relative; min-height: 120px; display: flex; align-items: center; }
  .org-name > p { position: absolute; z-index: 0; margin: 0; color: var(--reef); font-family: var(--font-display); font-size: 8rem; line-height: 0.7; opacity: 0.55; }
  .org-name h3 { position: relative; z-index: 1; margin: 0; font-family: var(--font-display); font-size: var(--text-card); letter-spacing: -0.075em; line-height: 0.86; }
  .org-description { margin: 0; color: var(--ink-soft); }
  .organization dl { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin: 0; }
  .organization dl div { padding-left: 12px; border-left: 1px solid var(--line); }
  dt { color: var(--ink-soft); }
  dd { margin: 4px 0 0; font-family: var(--font-display); font-size: 2rem; line-height: 1; }
  .org-arrow { position: absolute; right: 20px; top: 50%; font-size: 1.4rem; transform: translateY(-50%); }
  .organization:hover, .organization:focus-visible { color: var(--paper-strong); background: var(--ink-deep); }
  .organization:hover .org-description, .organization:focus-visible .org-description, .organization:hover .org-number, .organization:focus-visible .org-number, .organization:hover dt, .organization:focus-visible dt { color: rgba(255,255,255,0.66); }
  .organization:hover .org-number span, .organization:focus-visible .org-number span { color: var(--accent); }
  .org-1 .org-name > p { color: var(--trove); }
  .org-2 .org-name > p { color: var(--kyn); }
  .org-3 .org-name > p { color: var(--media); }
  .org-4 .org-name > p { color: var(--venture); }

  @media (max-width: 940px) {
    .organization { grid-template-columns: 90px minmax(200px, 0.8fr) minmax(260px, 1fr); }
    .organization dl { grid-column: 2 / -1; max-width: 250px; }
  }

  @media (max-width: 700px) {
    .hero-note, .directory-heading { grid-template-columns: 1fr; }
    .organization { grid-template-columns: 70px 1fr; padding-right: 48px; }
    .org-name { min-height: 110px; }
    .org-name > p { font-size: 7rem; }
    .org-description, .organization dl { grid-column: 2; }
    .organization dl { max-width: 220px; }
  }

  @media (max-width: 420px) {
    .organization { grid-template-columns: 1fr; padding-left: 10px; }
    .org-number, .org-description, .organization dl { grid-column: 1; }
    .org-name { min-height: 96px; }
  }
</style>

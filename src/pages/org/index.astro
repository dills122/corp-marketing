---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ecosystem, projects } from "../../data/site";

const orgCards = ecosystem.map((org) => {
  const orgProjects = org.name === "Lady International" ? projects : projects.filter((project) => project.division === org.name);

  return {
    ...org,
    currentCount: orgProjects.filter((project) => project.phase !== "past").length,
    pastCount: orgProjects.filter((project) => project.phase === "past").length,
  };
});
---

<BaseLayout
  title="Organizations | Shwimp Studios"
  description="Organizations in the Lady International and Shwimp Studios ecosystem."
  canonicalPath="/org/"
>
    <main id="main-content">
      <section class="directory-hero" aria-labelledby="directory-title">
        <div>
          <p class="eyebrow">The ecosystem</p>
          <h1 id="directory-title">Organizations</h1>
          <p class="lede">
            Lady International organizes the work into a handful of small shops: public products, engineering tools,
            publishing, and exploratory ventures.
          </p>
        </div>
      </section>

      <section class="section" aria-label="Organization list">
        <div class="org-grid">
          {
            orgCards.map((org) => (
              <a class="org-card" href={`/org/${org.slug}/`}>
                <p>{org.role}</p>
                <h2>{org.name}</h2>
                <span>{org.description}</span>
                <dl>
                  <div>
                    <dt>Current</dt>
                    <dd>{org.currentCount}</dd>
                  </div>
                  <div>
                    <dt>Past</dt>
                    <dd>{org.pastCount}</dd>
                  </div>
                </dl>
              </a>
            ))
          }
        </div>
      </section>
    </main>

</BaseLayout>

<style>
  h1,
  h2 {
    font-family: Georgia, "Times New Roman", serif;
    letter-spacing: 0;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  .directory-hero {
    padding: clamp(58px, 8vw, 104px) 20px clamp(46px, 7vw, 82px);
    border-bottom: 1px solid var(--line);
    background-image:
      linear-gradient(90deg, rgba(251, 244, 231, 0.94), rgba(251, 244, 231, 0.78)),
      var(--hero-image);
    background-position: center;
    background-size: cover;
  }

  .directory-hero > div,
  .org-grid {
    width: min(100%, var(--max));
    margin-inline: auto;
  }

  .eyebrow,
  .org-card > p {
    margin: 0 0 14px;
    color: var(--coral);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  h1 {
    max-width: 920px;
    margin-bottom: 22px;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.92;
  }

  h2 {
    margin-bottom: 12px;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.02;
  }

  .lede,
  .org-card span {
    color: var(--ink-soft);
  }

  .lede {
    max-width: 760px;
    margin-bottom: 0;
    font-size: clamp(1.08rem, 2vw, 1.3rem);
  }

  .section {
    padding: clamp(54px, 8vw, 92px) 20px;
  }

  .org-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .org-card {
    min-height: 290px;
    padding: 22px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--paper-strong);
    transition:
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .org-card:hover,
  .org-card:focus-visible {
    z-index: 1;
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .org-card span {
    display: block;
  }

  .org-card dl {
    display: flex;
    gap: 18px;
    margin: 28px 0 0;
  }

  .org-card dt {
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .org-card dd {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.7rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .org-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .org-grid {
      grid-template-columns: 1fr;
    }
  }

</style>

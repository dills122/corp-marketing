---
import SiteFooter from "../../components/SiteFooter.astro";
import { ecosystem, projects } from "../../data/site";

const orgCards = ecosystem.map((org) => {
  const orgProjects = org.name === "Lady International" ? projects : projects.filter((project) => project.division === org.name);

  return {
    ...org,
    currentCount: orgProjects.filter((project) => project.phase !== "past").length,
    pastCount: orgProjects.filter((project) => project.phase === "past").length,
  };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Organizations in the Lady International and Shwimp Studios ecosystem." />
    <title>Organizations | Shwimp Studios</title>
  </head>
  <body>
    <header class="site-header" aria-label="Primary navigation">
      <a class="brand-mark" href="/" aria-label="Shwimp Studios home">
        <span class="brand-glyph" aria-hidden="true">SS</span>
        <span>
          <strong>Shwimp Studios</strong>
          <small>Lady International</small>
        </span>
      </a>
      <nav>
        <a href="/org/">Organizations</a>
        <a href="/#projects">Projects</a>
        <a href="/#studio">Studio</a>
      </nav>
    </header>

    <main>
      <section class="directory-hero" aria-labelledby="directory-title">
        <div>
          <p class="eyebrow">The ecosystem</p>
          <h1 id="directory-title">Organizations</h1>
          <p class="lede">
            Lady International organizes the work into a handful of small shops: public products, engineering tools,
            publishing, and exploratory ventures.
          </p>
        </div>
      </section>

      <section class="section" aria-label="Organization list">
        <div class="org-grid">
          {
            orgCards.map((org) => (
              <a class="org-card" href={`/org/${org.slug}/`}>
                <p>{org.role}</p>
                <h2>{org.name}</h2>
                <span>{org.description}</span>
                <dl>
                  <div>
                    <dt>Current</dt>
                    <dd>{org.currentCount}</dd>
                  </div>
                  <div>
                    <dt>Past</dt>
                    <dd>{org.pastCount}</dd>
                  </div>
                </dl>
              </a>
            ))
          }
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :root {
    --ink: #172637;
    --ink-soft: #536170;
    --paper: #fbf4e7;
    --paper-strong: #fffaf1;
    --blue: #214f6f;
    --coral: #b25e46;
    --line: rgba(23, 38, 55, 0.16);
    --shadow: 0 18px 44px rgba(23, 38, 55, 0.1);
    --radius: 8px;
    --max: 1180px;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color: var(--ink);
    background: var(--paper);
  }

  body {
    margin: 0;
    min-width: 320px;
    font-size: 16px;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    padding: 14px max(18px, calc((100vw - var(--max)) / 2));
    border-bottom: 1px solid var(--line);
    background: rgba(251, 244, 231, 0.9);
    backdrop-filter: blur(18px);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .brand-mark strong,
  .brand-mark small {
    display: block;
    white-space: nowrap;
  }

  .brand-mark strong,
  h1,
  h2 {
    font-family: Georgia, "Times New Roman", serif;
    letter-spacing: 0;
  }

  .brand-mark strong {
    font-size: 1.1rem;
    line-height: 1.05;
  }

  .brand-mark small {
    color: var(--ink-soft);
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .brand-glyph {
    display: grid;
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    color: var(--paper-strong);
    background: var(--ink);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .site-header nav a {
    padding: 8px 10px;
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.88rem;
    font-weight: 800;
  }

  .site-header nav a:hover,
  .site-header nav a:focus-visible {
    color: var(--ink);
    background: rgba(33, 79, 111, 0.1);
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  .directory-hero {
    padding: clamp(58px, 8vw, 104px) 20px clamp(46px, 7vw, 82px);
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(90deg, rgba(251, 244, 231, 0.94), rgba(251, 244, 231, 0.78)),
      url("/studio-hero-v2.png") center / cover;
  }

  .directory-hero > div,
  .org-grid {
    width: min(100%, var(--max));
    margin-inline: auto;
  }

  .eyebrow,
  .org-card > p {
    margin: 0 0 14px;
    color: var(--coral);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  h1 {
    max-width: 920px;
    margin-bottom: 22px;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.92;
  }

  h2 {
    margin-bottom: 12px;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.02;
  }

  .lede,
  .org-card span {
    color: var(--ink-soft);
  }

  .lede {
    max-width: 760px;
    margin-bottom: 0;
    font-size: clamp(1.08rem, 2vw, 1.3rem);
  }

  .section {
    padding: clamp(54px, 8vw, 92px) 20px;
  }

  .org-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .org-card {
    min-height: 290px;
    padding: 22px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--paper-strong);
    transition:
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .org-card:hover,
  .org-card:focus-visible {
    z-index: 1;
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .org-card span {
    display: block;
  }

  .org-card dl {
    display: flex;
    gap: 18px;
    margin: 28px 0 0;
  }

  .org-card dt {
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .org-card dd {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.7rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .org-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      padding-inline: 12px;
    }

    .site-header nav {
      justify-content: flex-end;
      gap: 2px;
    }

    .site-header nav a {
      padding: 6px 5px;
      font-size: 0.76rem;
    }

    .brand-mark small {
      display: none;
    }

    .org-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .brand-mark strong {
      max-width: 116px;
      white-space: normal;
      font-size: 0.96rem;
    }

    .brand-glyph {
      width: 34px;
      height: 34px;
    }
  }
</style>

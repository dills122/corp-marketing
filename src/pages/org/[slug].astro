---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ecosystem, projects } from "../../data/site";

export function getStaticPaths() {
  return ecosystem.map((org) => ({
    params: { slug: org.slug },
    props: { org },
  }));
}

const { org } = Astro.props;
const orgProjects = org.name === "Lady International" ? projects : projects.filter((project) => project.division === org.name);
const currentProjects = orgProjects.filter((project) => project.phase !== "past");
const pastProjects = orgProjects.filter((project) => project.phase === "past");
const pageDescription = `${org.name}: ${org.description}`;
---

<BaseLayout title={`${org.name} | Shwimp Studios`} description={pageDescription} canonicalPath={`/org/${org.slug}/`}>
    <main id="main-content">
      <section class="org-hero" aria-labelledby="org-title">
        <div>
          <a class="back-link" href="/org/">Back to organizations</a>
          <p class="eyebrow">{org.role}</p>
          <h1 id="org-title">{org.name}</h1>
          <p class="lede">{org.overview}</p>
        </div>
      </section>

      <section class="section" aria-labelledby="current-title">
        <div class="section-heading split">
          <div>
            <p class="eyebrow">Current work</p>
            <h2 id="current-title">Active projects</h2>
          </div>
          <p>
            Public and in-progress work currently associated with {org.name}. Some projects are still private while they take shape.
          </p>
        </div>

        {
          currentProjects.length > 0 ? (
            <div class="project-grid">
              {currentProjects.map((project) => (
                <article class="project-card">
                  <div class="project-topline">
                    <span>{project.division}</span>
                    <strong>{project.status}</strong>
                  </div>
                  <h3>{project.name}</h3>
                  <p class="project-kicker">{project.kicker}</p>
                  <p>{project.summary}</p>
                  <div class="project-links" role="group" aria-label={`${project.name} links`}>
                    {project.links?.map((link) => (
                      <a href={link.href} target="_blank" rel="noopener noreferrer">
                        {link.label}
                      </a>
                    ))}
                    {project.availability && <span>{project.availability}</span>}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="empty-state">No current public projects are listed for {org.name} yet.</p>
          )
        }
      </section>

      <section class="section past-work" aria-labelledby="past-title">
        <div class="section-heading split">
          <div>
            <p class="eyebrow">Archive</p>
            <h2 id="past-title">Past projects</h2>
          </div>
          <p>Older releases, retired experiments, and archived work will live here as the studio history fills in.</p>
        </div>

        {
          pastProjects.length > 0 ? (
            <div class="project-grid">
              {pastProjects.map((project) => (
                <article class="project-card">
                  <div class="project-topline">
                    <span>{project.division}</span>
                    <strong>{project.status}</strong>
                  </div>
                  <h3>{project.name}</h3>
                  <p class="project-kicker">{project.kicker}</p>
                  <p>{project.summary}</p>
                  <div class="project-links" role="group" aria-label={`${project.name} links`}>
                    {project.links?.map((link) => (
                      <a href={link.href} target="_blank" rel="noopener noreferrer">
                        {link.label}
                      </a>
                    ))}
                    {project.availability && <span>{project.availability}</span>}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="empty-state">No archived projects are listed for {org.name} yet.</p>
          )
        }
      </section>
    </main>

</BaseLayout>

<style>
  h1,
  h2,
  h3 {
    font-family: Georgia, "Times New Roman", serif;
    letter-spacing: 0;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  .org-hero {
    padding: clamp(58px, 8vw, 104px) 20px clamp(46px, 7vw, 82px);
    border-bottom: 1px solid var(--line);
    background-image:
      linear-gradient(90deg, rgba(251, 244, 231, 0.94), rgba(251, 244, 231, 0.78)),
      var(--hero-image);
    background-position: center;
    background-size: cover;
  }

  .org-hero > div,
  .section-heading,
  .project-grid,
  .empty-state {
    width: min(100%, var(--max));
    margin-inline: auto;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 26px;
    color: var(--blue);
    font-size: 0.88rem;
    font-weight: 900;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--coral);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  h1 {
    max-width: 920px;
    margin-bottom: 22px;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.92;
  }

  h2 {
    margin-bottom: 18px;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1;
  }

  h3 {
    margin-bottom: 8px;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    line-height: 1.05;
  }

  .lede,
  .section-heading > p,
  .project-card p,
  .empty-state {
    color: var(--ink-soft);
  }

  .lede {
    max-width: 760px;
    margin-bottom: 0;
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    text-wrap: balance;
  }

  .section {
    padding: clamp(54px, 8vw, 92px) 20px;
  }

  .section-heading {
    margin-bottom: 26px;
  }

  .section-heading.split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.72fr);
    gap: 30px;
    align-items: end;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .project-card {
    min-height: 260px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-strong);
    box-shadow: var(--shadow);
  }

  .project-topline {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .project-topline strong {
    color: var(--coral);
  }

  .project-kicker {
    margin-bottom: 12px;
    color: var(--ink);
    font-size: 1.02rem;
    font-weight: 900;
  }

  .project-links {
    margin-top: 18px;
  }

  .project-links a,
  .project-links span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 250, 241, 0.72);
    font-size: 0.84rem;
    font-weight: 900;
  }

  .project-links a:hover,
  .project-links a:focus-visible {
    color: var(--blue);
    background: #edf5f8;
  }

  .project-links span,
  .empty-state {
    color: var(--ink-soft);
  }

  .empty-state {
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }

  .past-work {
    background: var(--paper-strong);
  }

  @media (max-width: 760px) {
    .section-heading.split,
    .project-grid {
      grid-template-columns: 1fr;
    }
  }

</style>

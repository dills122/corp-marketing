---
import SiteFooter from "../../components/SiteFooter.astro";
import { ecosystem, projects } from "../../data/site";

export function getStaticPaths() {
  return ecosystem.map((org) => ({
    params: { slug: org.slug },
    props: { org },
  }));
}

const { org } = Astro.props;
const orgProjects = org.name === "Lady International" ? projects : projects.filter((project) => project.division === org.name);
const currentProjects = orgProjects.filter((project) => project.phase !== "past");
const pastProjects = orgProjects.filter((project) => project.phase === "past");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${org.name}: ${org.description}`} />
    <title>{org.name} | Shwimp Studios</title>
  </head>
  <body>
    <header class="site-header" aria-label="Primary navigation">
      <a class="brand-mark" href="/" aria-label="Shwimp Studios home">
        <span class="brand-glyph" aria-hidden="true">SS</span>
        <span>
          <strong>Shwimp Studios</strong>
          <small>Lady International</small>
        </span>
      </a>
      <nav>
        <a href="/org/">Organizations</a>
        <a href="/#projects">Projects</a>
        <a href="/#studio">Studio</a>
      </nav>
    </header>

    <main>
      <section class="org-hero" aria-labelledby="org-title">
        <div>
          <a class="back-link" href="/org/">Back to organizations</a>
          <p class="eyebrow">{org.role}</p>
          <h1 id="org-title">{org.name}</h1>
          <p class="lede">{org.overview}</p>
        </div>
      </section>

      <section class="section" aria-labelledby="current-title">
        <div class="section-heading split">
          <div>
            <p class="eyebrow">Current work</p>
            <h2 id="current-title">Active projects</h2>
          </div>
          <p>
            Public and in-progress work currently associated with {org.name}. Some projects are still private while they take shape.
          </p>
        </div>

        {
          currentProjects.length > 0 ? (
            <div class="project-grid">
              {currentProjects.map((project) => (
                <article class="project-card">
                  <div class="project-topline">
                    <span>{project.division}</span>
                    <strong>{project.status}</strong>
                  </div>
                  <h3>{project.name}</h3>
                  <p class="project-kicker">{project.kicker}</p>
                  <p>{project.summary}</p>
                  <div class="project-links" aria-label={`${project.name} links`}>
                    {project.links?.map((link) => (
                      <a href={link.href} target="_blank" rel="noreferrer">
                        {link.label}
                      </a>
                    ))}
                    {project.availability && <span>{project.availability}</span>}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="empty-state">No current public projects are listed for {org.name} yet.</p>
          )
        }
      </section>

      <section class="section past-work" aria-labelledby="past-title">
        <div class="section-heading split">
          <div>
            <p class="eyebrow">Archive</p>
            <h2 id="past-title">Past projects</h2>
          </div>
          <p>Older releases, retired experiments, and archived work will live here as the studio history fills in.</p>
        </div>

        {
          pastProjects.length > 0 ? (
            <div class="project-grid">
              {pastProjects.map((project) => (
                <article class="project-card">
                  <div class="project-topline">
                    <span>{project.division}</span>
                    <strong>{project.status}</strong>
                  </div>
                  <h3>{project.name}</h3>
                  <p class="project-kicker">{project.kicker}</p>
                  <p>{project.summary}</p>
                  <div class="project-links" aria-label={`${project.name} links`}>
                    {project.links?.map((link) => (
                      <a href={link.href} target="_blank" rel="noreferrer">
                        {link.label}
                      </a>
                    ))}
                    {project.availability && <span>{project.availability}</span>}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="empty-state">No archived projects are listed for {org.name} yet.</p>
          )
        }
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :root {
    --ink: #172637;
    --ink-soft: #536170;
    --paper: #fbf4e7;
    --paper-strong: #fffaf1;
    --blue: #214f6f;
    --green: #496b53;
    --coral: #b25e46;
    --line: rgba(23, 38, 55, 0.16);
    --shadow: 0 18px 44px rgba(23, 38, 55, 0.1);
    --radius: 8px;
    --max: 1180px;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color: var(--ink);
    background: var(--paper);
  }

  body {
    margin: 0;
    min-width: 320px;
    font-size: 16px;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    padding: 14px max(18px, calc((100vw - var(--max)) / 2));
    border-bottom: 1px solid var(--line);
    background: rgba(251, 244, 231, 0.9);
    backdrop-filter: blur(18px);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .brand-mark strong,
  .brand-mark small {
    display: block;
    white-space: nowrap;
  }

  .brand-mark strong,
  h1,
  h2,
  h3 {
    font-family: Georgia, "Times New Roman", serif;
    letter-spacing: 0;
  }

  .brand-mark strong {
    font-size: 1.1rem;
    line-height: 1.05;
  }

  .brand-mark small {
    color: var(--ink-soft);
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .brand-glyph {
    display: grid;
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    color: var(--paper-strong);
    background: var(--ink);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .site-header nav,
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .site-header nav a {
    padding: 8px 10px;
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.88rem;
    font-weight: 800;
  }

  .site-header nav a:hover,
  .site-header nav a:focus-visible {
    color: var(--ink);
    background: rgba(33, 79, 111, 0.1);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  .org-hero {
    padding: clamp(58px, 8vw, 104px) 20px clamp(46px, 7vw, 82px);
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(90deg, rgba(251, 244, 231, 0.94), rgba(251, 244, 231, 0.78)),
      url("/studio-hero-v2.png") center / cover;
  }

  .org-hero > div,
  .section-heading,
  .project-grid,
  .empty-state {
    width: min(100%, var(--max));
    margin-inline: auto;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 26px;
    color: var(--blue);
    font-size: 0.88rem;
    font-weight: 900;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--coral);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  h1 {
    max-width: 920px;
    margin-bottom: 22px;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.92;
  }

  h2 {
    margin-bottom: 18px;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1;
  }

  h3 {
    margin-bottom: 8px;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    line-height: 1.05;
  }

  .lede,
  .section-heading > p,
  .project-card p,
  .empty-state {
    color: var(--ink-soft);
  }

  .lede {
    max-width: 760px;
    margin-bottom: 0;
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    text-wrap: balance;
  }

  .section {
    padding: clamp(54px, 8vw, 92px) 20px;
  }

  .section-heading {
    margin-bottom: 26px;
  }

  .section-heading.split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.72fr);
    gap: 30px;
    align-items: end;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .project-card {
    min-height: 260px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-strong);
    box-shadow: var(--shadow);
  }

  .project-topline {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .project-topline strong {
    color: var(--coral);
  }

  .project-kicker {
    margin-bottom: 12px;
    color: var(--ink);
    font-size: 1.02rem;
    font-weight: 900;
  }

  .project-links {
    margin-top: 18px;
  }

  .project-links a,
  .project-links span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 250, 241, 0.72);
    font-size: 0.84rem;
    font-weight: 900;
  }

  .project-links a:hover,
  .project-links a:focus-visible {
    color: var(--blue);
    background: #edf5f8;
  }

  .project-links span,
  .empty-state {
    color: var(--ink-soft);
  }

  .empty-state {
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }

  .past-work {
    background: var(--paper-strong);
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      padding-inline: 12px;
    }

    .site-header nav {
      justify-content: flex-end;
      gap: 2px;
    }

    .site-header nav a {
      padding: 6px 5px;
      font-size: 0.76rem;
    }

    .brand-mark small {
      display: none;
    }

    .section-heading.split,
    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .brand-mark strong {
      max-width: 116px;
      white-space: normal;
      font-size: 0.96rem;
    }

    .brand-glyph {
      width: 34px;
      height: 34px;
    }
  }
</style>

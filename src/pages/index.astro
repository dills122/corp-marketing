---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ecosystem, leaders, projects } from "../data/site";

const featuredProjects = projects.filter((project) => project.featured);
const toProjectId = (name: string) => `project-${name.toLowerCase().replaceAll(" ", "-")}`;
---

<BaseLayout
  title="Shwimp Studios | Software, tools, experiments"
  description="Shwimp Studios is an independent software studio and engineering lab building tools, experiments, and a strange little universe of named projects."
  canonicalPath="/"
>
    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">Independent software studio / engineering lab</p>
            <h1 id="hero-title">Shwimp Studios builds software, tools, experiments, and occasionally questionable ideas.</h1>
            <p class="lede">
              A small creative technology shop inside Lady International, organized around useful products, strange research threads, and a naming system that has already gone too far.
            </p>
            <div class="hero-actions" role="group" aria-label="Hero actions">
              <a class="button primary" href="#projects">Explore projects</a>
              <a class="button secondary" href="#ecosystem">Map the ecosystem</a>
            </div>
          </div>

        </div>
      </section>

      <section class="section ecosystem" id="ecosystem" aria-labelledby="ecosystem-title">
        <div class="section-heading">
          <p class="eyebrow">The ecosystem</p>
          <h2 id="ecosystem-title">A holding company with a product studio, an engineering bench, a media shelf, and an incubator.</h2>
          <p>
            The site should not feel like a generic consultancy because the work is not organized like one. Each name has a job, and the projects make more sense when that structure is visible.
          </p>
        </div>

        <div class="ecosystem-grid">
          {
            ecosystem.map((item) => (
              <a class="ecosystem-card" href={`/org/${item.slug}/`}>
                <p>{item.role}</p>
                <h3>{item.name}</h3>
                <span>{item.description}</span>
                <strong>View organization</strong>
              </a>
            ))
          }
        </div>
      </section>

      <section class="section project-showcase" id="projects" aria-labelledby="projects-title">
        <div class="section-heading split">
          <div>
            <p class="eyebrow">Featured projects</p>
            <h2 id="projects-title">The projects are the point.</h2>
          </div>
          <p>
            Shwimp Studios is less interesting as a slogan than as a catalog of living things: simulators, bookmark systems, developer tools, and retro-web experiments with enough personality to remember.
          </p>
        </div>

        <div class="project-list">
          {
            featuredProjects.map((project, index) => (
              <article id={toProjectId(project.name)} class={`project-row ${project.tone}`}>
                <div class="project-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
                <div class="project-main">
                  <div class="project-topline">
                    <span>{project.division}</span>
                    <strong>{project.status}</strong>
                  </div>
                  <h3>{project.name}</h3>
                  <p class="project-kicker">{project.kicker}</p>
                  <p class="project-summary">{project.summary}</p>
                  <div class="project-links" role="group" aria-label={`${project.name} links`}>
                    {
                      project.links?.map((link) => (
                        <a href={link.href} target="_blank" rel="noopener noreferrer">
                          {link.label}
                        </a>
                      ))
                    }
                    {project.availability && <span>{project.availability}</span>}
                  </div>
                </div>
                <div class="project-mark" aria-hidden="true">
                  <span>{project.name.slice(0, 1)}</span>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section studio" id="studio" aria-labelledby="studio-title">
        <div class="studio-layout">
          <div class="section-heading">
            <p class="eyebrow">Studio governance</p>
            <h2 id="studio-title">Executive leadership for a very serious organization.</h2>
            <p>
              Lady International maintains a compact leadership structure, clear operating principles, and an unusually high tolerance for ideas that begin as jokes and become infrastructure.
            </p>
          </div>

          <div class="leader-list">
            {
              leaders.map((leader) => (
                <article class="leader-card">
                  <picture>
                    <source
                      type="image/avif"
                      srcset={`${leader.image}-220.avif 220w, ${leader.image}-440.avif 440w`}
                      sizes="(max-width: 760px) 220px, 132px"
                    />
                    <source
                      type="image/webp"
                      srcset={`${leader.image}-220.webp 220w, ${leader.image}-440.webp 440w`}
                      sizes="(max-width: 760px) 220px, 132px"
                    />
                    <img
                      src={`${leader.image}-440.jpg`}
                      width="440"
                      height="440"
                      loading="lazy"
                      decoding="async"
                      alt={`Editorial portrait illustration of ${leader.name}.`}
                    />
                  </picture>
                  <div>
                    <p class="card-label">{leader.title}</p>
                    <h3>{leader.name}</h3>
                    <p class="leader-alias">{leader.alias}</p>
                    <p class="leader-note">{leader.note}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    </main>

</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background-image:
      linear-gradient(90deg, rgba(251, 244, 231, 0.92), rgba(251, 244, 231, 0.72)),
      var(--hero-image);
    background-position: center;
    background-size: cover;
  }

  .hero-inner {
    width: min(calc(100% - 40px), var(--max));
    min-height: calc(78svh - 67px);
    margin: 0 auto;
    padding: clamp(22px, 3vw, 36px) 0 clamp(24px, 4vw, 40px);
  }

  .hero-copy {
    max-width: 920px;
  }

  .eyebrow,
  .card-label {
    margin: 0 0 14px;
    color: var(--coral);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  .project-row h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 700;
    letter-spacing: 0;
    text-wrap: balance;
  }

  h1 {
    max-width: 860px;
    margin-bottom: 24px;
    font-size: clamp(2.85rem, 5vw, 4.65rem);
    line-height: 0.94;
  }

  h2 {
    margin-bottom: 18px;
    font-size: clamp(2.1rem, 4.4vw, 4.15rem);
    line-height: 0.98;
  }

  h3 {
    margin-bottom: 10px;
    font-size: 1.34rem;
    line-height: 1.2;
  }

  .lede {
    max-width: 720px;
    margin-bottom: 30px;
    color: var(--ink-soft);
    font-size: clamp(1.06rem, 2vw, 1.28rem);
    text-wrap: balance;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 18px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-weight: 900;
    transition:
      transform 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button.primary {
    color: var(--paper-strong);
    background: var(--ink);
  }

  .button.primary:hover,
  .button.primary:focus-visible {
    background: var(--blue);
  }

  .button.secondary {
    color: var(--ink);
    background: rgba(255, 250, 241, 0.54);
  }

  .button.secondary:hover,
  .button.secondary:focus-visible {
    color: var(--paper-strong);
    background: var(--green);
  }

  .section {
    padding: clamp(56px, 8vw, 104px) 20px;
  }

  .section-heading,
  .ecosystem-grid,
  .project-list,
  .studio-layout {
    width: min(100%, var(--max));
    margin-inline: auto;
  }

  .section-heading {
    max-width: 880px;
    margin-bottom: 30px;
  }

  .section-heading > p,
  .section-heading.split > p,
  .ecosystem-card span,
  .project-row p,
  .leader-card p {
    color: var(--ink-soft);
  }

  .section-heading > p,
  .section-heading.split > p {
    max-width: 650px;
    font-size: 1.04rem;
  }

  .section-heading.split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.72fr);
    gap: 30px;
    max-width: none;
    align-items: end;
  }

  .ecosystem {
    background: var(--paper-strong);
  }

  .ecosystem-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .ecosystem-card {
    display: block;
    min-height: 260px;
    padding: 22px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--paper-strong);
    transition:
      background 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .ecosystem-card:hover,
  .ecosystem-card:focus-visible {
    z-index: 1;
    background: #fffaf1;
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .ecosystem-card:nth-child(2) {
    background: #edf3ed;
  }

  .ecosystem-card:nth-child(3) {
    background: #edf5f8;
  }

  .ecosystem-card:nth-child(4) {
    background: #f8efe8;
  }

  .ecosystem-card:nth-child(5) {
    background: #f7ecd4;
  }

  .ecosystem-card p {
    margin-bottom: 38px;
    color: var(--coral);
    font-size: 0.76rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .ecosystem-card h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    letter-spacing: 0;
  }

  .ecosystem-card span {
    display: block;
  }

  .ecosystem-card strong {
    display: inline-flex;
    margin-top: 22px;
    color: var(--blue);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .project-showcase {
    background: #f2eadb;
  }

  .project-list {
    display: grid;
    gap: 18px;
  }

  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) 180px;
    gap: clamp(18px, 4vw, 46px);
    align-items: center;
    min-height: 300px;
    padding: clamp(22px, 4vw, 42px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-strong);
    box-shadow: 0 14px 38px rgba(23, 38, 55, 0.08);
  }

  .project-row.reef {
    border-color: rgba(33, 79, 111, 0.32);
  }

  .project-row.trove {
    border-color: rgba(196, 147, 66, 0.42);
  }

  .project-row.kyn {
    border-color: rgba(73, 107, 83, 0.36);
  }

  .project-row.waves {
    border-color: rgba(178, 94, 70, 0.36);
  }

  .project-index {
    color: rgba(23, 38, 55, 0.28);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    line-height: 1;
  }

  .project-topline {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 18px;
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .project-topline strong {
    color: var(--coral);
  }

  .project-row h3 {
    margin-bottom: 6px;
    font-size: clamp(2.8rem, 7vw, 6.2rem);
    line-height: 0.9;
  }

  .project-kicker {
    margin-bottom: 14px;
    color: var(--ink);
    font-size: clamp(1.02rem, 2vw, 1.25rem);
    font-weight: 900;
  }

  .project-summary {
    max-width: 660px;
    margin-bottom: 20px;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .project-links a,
  .project-links span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    background: rgba(255, 250, 241, 0.72);
    font-size: 0.84rem;
    font-weight: 900;
  }

  .project-links a:hover,
  .project-links a:focus-visible {
    border-color: rgba(33, 79, 111, 0.42);
    color: var(--blue);
    background: #edf5f8;
  }

  .project-links span {
    color: var(--ink-soft);
    background: rgba(23, 38, 55, 0.06);
  }

  .project-mark {
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: #edf5f8;
  }

  .trove .project-mark {
    background: #f7ecd4;
  }

  .kyn .project-mark {
    background: #eaf1e8;
  }

  .waves .project-mark {
    background: #f8e7df;
  }

  .project-mark span {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4rem, 9vw, 7rem);
    line-height: 1;
  }

  .studio {
    background: var(--paper);
  }

  .studio-layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 70px);
    align-items: start;
  }

  .studio-layout .section-heading {
    position: sticky;
    top: 104px;
    margin-bottom: 0;
  }

  .leader-list {
    display: grid;
    gap: 18px;
  }

  .leader-card {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-strong);
    box-shadow: 0 12px 32px rgba(23, 38, 55, 0.07);
  }

  .leader-card picture {
    width: 132px;
  }

  .leader-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .leader-card h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    letter-spacing: 0;
  }

  .leader-alias {
    margin-bottom: 10px;
    color: var(--green);
    font-size: 0.92rem;
    font-weight: 900;
  }

  .leader-note {
    margin-bottom: 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  @media (max-width: 1040px) {
    .studio-layout {
      grid-template-columns: 1fr;
    }

    .hero-inner {
      min-height: auto;
    }

    .ecosystem-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-row {
      grid-template-columns: 70px minmax(0, 1fr);
    }

    .project-mark {
      display: none;
    }

    .studio-layout .section-heading {
      position: static;
    }
  }

  @media (max-width: 760px) {
    .hero-inner {
      width: min(calc(100% - 28px), var(--max));
      padding-top: 24px;
    }

    h1 {
      font-size: clamp(2.45rem, 11vw, 3.15rem);
    }

    .section-heading.split,
    .ecosystem-grid,
    .project-row,
    .leader-card {
      grid-template-columns: 1fr;
    }

    .ecosystem-card {
      min-height: 230px;
    }

    .project-row {
      min-height: 0;
    }

    .project-index {
      font-size: 2rem;
    }

    .leader-card picture {
      width: 100%;
      max-width: 220px;
    }
  }

  @media (max-width: 520px) {
    .button {
      width: 100%;
    }

    .section {
      padding-inline: 14px;
    }
  }
</style>

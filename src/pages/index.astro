---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ecosystem, leaders, projects } from "../data/site";

const featuredProjects = projects.filter((project) => project.featured);
const spotlight = featuredProjects[0];
const supportingReleases = featuredProjects.slice(1);
const parentOrganization = ecosystem[0];
const operatingOrganizations = ecosystem.slice(1);
const founder = leaders.find((leader) => leader.name === "D. Steele");
const toProjectId = (name: string) => `project-${name.toLowerCase().replaceAll(" ", "-")}`;
---

<BaseLayout
  title="Shwimp Studios | Software, tools, experiments"
  description="Shwimp Studios is an independent software studio and engineering lab building tools, experiments, and a strange little universe of named projects."
  canonicalPath="/"
>
  <main id="main-content">
    <section class="hero" id="index" aria-labelledby="hero-title">
      <div class="hero-inner">
        <p class="hero-kicker">Independent software studio · Central PA / Internet</p>
        <h1 id="hero-title">Useful software for curious people and <span>questionable ideas.</span></h1>
        <div class="hero-foot">
          <div class="hero-intro">
            <p>
              We build practical software for developers, knowledge workers, market enthusiasts, and anyone curious
              enough to follow an idea past the sensible stopping point.
            </p>
            {founder && (
              <a class="founder-note" href="#studio">
                <span>Built and maintained by</span>
                <strong>{founder.name} · {founder.alias}</strong>
              </a>
            )}
          </div>
          <div class="hero-actions" aria-label="Homepage shortcuts">
            <a class="action primary" href="#project-reef">Meet Reef <span aria-hidden="true">↓</span></a>
            <a class="action secondary" href="/projects/">All projects</a>
          </div>
        </div>
      </div>
      <div class="hero-ticker" aria-hidden="true">
        <span>Software</span><b>◆</b><span>Tools</span><b>◆</b><span>Research</span><b>◆</b><span>Oddities</span>
      </div>
    </section>

    <section class="releases" id="projects" aria-labelledby="projects-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">New and ongoing · Edition 01</p>
          <h2 id="projects-title">The projects are the point.</h2>
        </div>
        <p>
          Each release gets its own world. Some become products, some remain experiments, and some are best understood
          as evidence of a productive afternoon getting out of hand.
        </p>
      </div>

      <article id={toProjectId(spotlight.name)} class={`spotlight ${spotlight.tone}`}>
        <div class="spotlight-art" aria-hidden="true">
          <span class="art-orbit one"></span>
          <span class="art-orbit two"></span>
          <span class="art-axis"></span>
          <strong>{spotlight.name.slice(0, 1)}</strong>
          <small>01</small>
        </div>
        <div class="spotlight-copy">
          <div class="release-meta">
            <span>Release 01</span>
            <strong>{spotlight.status}</strong>
          </div>
          <p class="division">From {spotlight.division}</p>
          <h3>{spotlight.name}</h3>
          <p class="release-kicker">{spotlight.kicker}</p>
          <p class="release-summary">{spotlight.summary}</p>
          <div class="release-actions">
            {spotlight.links?.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
            ))}
          </div>
        </div>
      </article>

      <div class="release-list">
        {
          supportingReleases.map((project, index) => (
            <article id={toProjectId(project.name)} class={`release ${project.tone}`}>
              <div class="release-art" aria-hidden="true">
                <span class="art-shape a"></span>
                <span class="art-shape b"></span>
                <span class="art-shape c"></span>
                <strong>{project.name.slice(0, 1)}</strong>
                <small>0{index + 2}</small>
              </div>
              <div class="release-copy">
                <div class="release-meta">
                  <span>Release 0{index + 2}</span>
                  <strong>{project.status}</strong>
                </div>
                <p class="division">From {project.division}</p>
                <h3>{project.name}</h3>
                <p class="release-kicker">{project.kicker}</p>
                <p class="release-summary">{project.summary}</p>
                <div class="release-actions" aria-label={`${project.name} links`}>
                  {project.links?.map((link) => (
                    <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="catalog-link">
        <p><span>{projects.length}</span> named projects and counting.</p>
        <a href="/projects/">Browse every project <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="studio-family" id="ecosystem" aria-labelledby="ecosystem-title">
      <div class="family-intro">
        <p class="eyebrow">Inside the studio</p>
        <h2 id="ecosystem-title">One parent.<br />Four divisions.<br /><span>No sensible stopping point.</span></h2>
        <div class="family-note">
          <p>
            <strong>{parentOrganization.name}</strong> is the parent structure for a small universe of studios,
            projects, names, and long-running bets.
          </p>
          <a href={`/org/${parentOrganization.slug}/`}>Meet the parent company <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="divisions">
        {
          operatingOrganizations.map((item, index) => (
            <a class={`division-card division-card-${index + 1}`} href={`/org/${item.slug}/`}>
              <span>0{index + 1}</span>
              <p>{item.role}</p>
              <h3>{item.name}</h3>
              <small>{item.description}</small>
              <strong>Explore the division <b aria-hidden="true">↗</b></strong>
            </a>
          ))
        }
      </div>
    </section>

    <section class="research-note" aria-labelledby="note-title">
      <div class="note-label">
        <p>Research note · 01</p>
        <span>On naming things</span>
      </div>
      <blockquote id="note-title">
        “A project becomes considerably harder to abandon once it has a name, a division, and mild internal political support.”
      </blockquote>
      <p class="note-credit">— Shwimp Studios working principle, unofficial</p>
    </section>

    <section class="people" id="studio" aria-labelledby="studio-title">
      <div class="section-heading light">
        <div>
          <p class="eyebrow">The executive office</p>
          <h2 id="studio-title">Leadership with excellent instincts.</h2>
        </div>
        <p>
          A compact leadership structure with an unusually high tolerance for ideas that begin as jokes and become
          infrastructure.
        </p>
      </div>

      <div class="people-list">
        {
          leaders.map((leader, index) => (
            <article class="person">
              <div class="portrait">
                <span aria-hidden="true">0{index + 1}</span>
                <picture>
                  <source type="image/avif" srcset={`${leader.image}-220.avif 220w, ${leader.image}-440.avif 440w`} sizes="(max-width: 680px) 100vw, 300px" />
                  <source type="image/webp" srcset={`${leader.image}-220.webp 220w, ${leader.image}-440.webp 440w`} sizes="(max-width: 680px) 100vw, 300px" />
                  <img src={`${leader.image}-440.jpg`} width="440" height="440" loading="lazy" decoding="async" alt={`Editorial portrait illustration of ${leader.name}.`} />
                </picture>
              </div>
              <div class="person-copy">
                <p>{leader.title}</p>
                <h3>{leader.name}</h3>
                <strong>Known aliases · {leader.alias}</strong>
                <span>{leader.note}</span>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, h3 { text-wrap: balance; }

  .eyebrow,
  .hero-kicker,
  .release-meta,
  .division,
  .release-actions,
  .catalog-link,
  .note-label,
  .note-credit,
  .person-copy > p,
  .person-copy > strong,
  .founder-note {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.065em;
    text-transform: uppercase;
  }

  .hero {
    color: var(--paper-strong);
    background: var(--ink-deep);
  }

  .hero-inner,
  .section-heading,
  .spotlight,
  .release-list,
  .catalog-link,
  .family-intro,
  .divisions,
  .research-note,
  .people-list {
    width: min(100%, var(--max));
    margin-inline: auto;
  }

  .hero-inner {
    padding: clamp(48px, 6vw, 80px) var(--gutter) clamp(40px, 4vw, 56px);
  }

  .hero-kicker {
    margin-bottom: clamp(22px, 3vw, 38px);
    color: var(--reef);
  }

  .hero h1 {
    max-width: 1220px;
    margin-bottom: clamp(32px, 4vw, 48px);
    font-family: var(--font-display);
    font-size: var(--text-hero);
    letter-spacing: -0.075em;
    line-height: 0.86;
    overflow-wrap: anywhere;
  }

  .hero h1 span { color: var(--accent); }

  .hero-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 8vw, 120px);
    align-items: end;
    padding-top: var(--space-md);
    border-top: 1px solid rgba(255, 253, 247, 0.32);
  }

  .hero-intro > p {
    max-width: 760px;
    margin: 0;
    color: rgba(255, 253, 247, 0.72);
    font-family: var(--font-editorial);
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    line-height: 1.5;
  }

  .founder-note {
    display: inline-grid;
    gap: 3px;
    margin-top: 19px;
    color: rgba(255, 253, 247, 0.55);
    transition: color 140ms ease;
  }

  .founder-note strong { color: var(--reef); }
  .founder-note:hover, .founder-note:focus-visible { color: var(--paper-strong); }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; }

  .action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 26px;
    min-height: 52px;
    padding: 13px 17px;
    border: 1px solid rgba(255, 253, 247, 0.46);
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 140ms ease, background 140ms ease, border-color 140ms ease;
  }

  .action.primary { color: var(--ink-deep); background: var(--paper-strong); }
  .action:hover, .action:focus-visible { color: var(--paper-strong); border-color: var(--accent); background: var(--accent); }

  .hero-ticker {
    display: flex;
    gap: clamp(18px, 4vw, 64px);
    justify-content: space-around;
    padding: 17px var(--gutter);
    overflow: hidden;
    color: var(--ink-deep);
    background: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.2vw, 1.8rem);
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero-ticker b { font-size: 0.55em; }

  .releases { padding: var(--section-space) var(--gutter); }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.55fr);
    gap: clamp(42px, 8vw, 120px);
    align-items: end;
    margin-bottom: clamp(38px, 5vw, 64px);
  }

  .eyebrow { margin-bottom: var(--space-md); color: var(--accent-dark); }

  .section-heading h2,
  .family-intro h2 {
    max-width: 900px;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-section);
    letter-spacing: -0.07em;
    line-height: 0.86;
  }

  .section-heading > p {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-editorial);
    font-size: 1.12rem;
  }

  .spotlight,
  .release {
    display: grid;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }

  .spotlight {
    grid-template-columns: minmax(320px, 1fr) minmax(340px, 0.9fr);
    min-height: 470px;
  }

  .spotlight-art,
  .release-art {
    position: relative;
    display: grid;
    min-height: 100%;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .spotlight-art { background: var(--reef); }
  .spotlight-art strong,
  .release-art strong {
    z-index: 2;
    font-family: var(--font-display);
    font-size: clamp(10rem, 26vw, 25rem);
    letter-spacing: -0.12em;
    line-height: 0.75;
  }

  .spotlight-art small,
  .release-art small {
    position: absolute;
    z-index: 3;
    right: 24px;
    bottom: 18px;
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 900;
  }

  .art-orbit {
    position: absolute;
    width: 78%;
    aspect-ratio: 1;
    border: 2px solid var(--ink-deep);
    border-radius: 50%;
  }

  .art-orbit.one { transform: translate(-25%, -18%); }
  .art-orbit.two { transform: translate(30%, 24%) scale(0.7); }
  .art-axis { position: absolute; width: 130%; height: 2px; background: var(--ink-deep); transform: rotate(-23deg); }

  .spotlight-copy,
  .release-copy {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3vw, 42px);
  }

  .release-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: auto;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .release-meta strong { color: var(--accent-dark); }
  .division { margin: clamp(26px, 3vw, 38px) 0 10px; color: var(--ink-soft); }

  .spotlight-copy h3,
  .release-copy h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-feature);
    letter-spacing: -0.085em;
    line-height: 0.8;
  }

  .release-kicker {
    margin: 16px 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .release-summary { max-width: 590px; margin-bottom: var(--space-md); color: var(--ink-soft); }
  .release-actions { display: flex; flex-wrap: wrap; gap: 9px; margin-top: auto; }

  .release-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 9px 13px;
    border: 1px solid var(--line-strong);
  }

  .release-actions a { transition: color 140ms ease, background 140ms ease; }
  .release-actions a:hover, .release-actions a:focus-visible { color: var(--paper-strong); background: var(--ink-deep); }

  .release-list { border-inline: 1px solid var(--line-strong); }

  .release {
    grid-template-columns: minmax(280px, 0.7fr) minmax(360px, 1.3fr);
    min-height: 360px;
    border-width: 0 0 1px;
  }

  .release:nth-child(even) { grid-template-columns: minmax(360px, 1.3fr) minmax(280px, 0.7fr); }
  .release:nth-child(even) .release-art { grid-column: 2; grid-row: 1; }
  .release:nth-child(even) .release-copy { grid-column: 1; grid-row: 1; }
  .release-art { border-right: 1px solid var(--line-strong); }
  .release:nth-child(even) .release-art { border-right: 0; border-left: 1px solid var(--line-strong); }
  .release.trove .release-art { background: var(--trove); }
  .release.kyn .release-art { background: var(--kyn); }
  .release.waves .release-art { background: var(--waves); }
  .release-art strong { font-size: clamp(9rem, 20vw, 18rem); }

  .art-shape { position: absolute; border: 2px solid var(--ink-deep); }
  .trove .art-shape.a { width: 62%; height: 38%; transform: rotate(8deg); }
  .trove .art-shape.b { width: 48%; height: 58%; transform: rotate(-13deg); }
  .trove .art-shape.c { width: 28%; height: 75%; transform: rotate(20deg); }
  .kyn .art-shape { width: 62%; height: 2px; background: var(--ink-deep); transform-origin: center; }
  .kyn .art-shape.a { transform: rotate(0deg); }
  .kyn .art-shape.b { transform: rotate(60deg); }
  .kyn .art-shape.c { transform: rotate(120deg); }
  .waves .art-shape { width: 70%; aspect-ratio: 1; border-radius: 50%; border-width: 2px; }
  .waves .art-shape.a { transform: translateX(-40%); }
  .waves .art-shape.b { transform: scale(0.68); }
  .waves .art-shape.c { transform: translateX(40%) scale(0.45); }

  .release-copy h3 { font-size: var(--text-feature); }
  .release-copy .division { margin-top: clamp(24px, 3vw, 34px); }

  .catalog-link {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    align-items: center;
    padding: 30px 0 0;
  }

  .catalog-link p { margin: 0; color: var(--ink-soft); }
  .catalog-link p span { margin-right: 7px; color: var(--accent); font-family: var(--font-display); font-size: 1.9rem; }
  .catalog-link a { display: inline-flex; gap: 30px; align-items: center; min-height: 48px; border-bottom: 2px solid var(--ink-deep); }
  .catalog-link a:hover, .catalog-link a:focus-visible { color: var(--accent-dark); border-color: var(--accent); }

  .studio-family { padding: var(--section-space) var(--gutter); color: var(--paper-strong); background: var(--ink-deep); }
  .family-intro { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.55fr); gap: clamp(40px, 7vw, 100px); align-items: end; }
  .family-intro .eyebrow { grid-column: 1 / -1; margin-bottom: 0; color: var(--trove); }
  .family-intro h2 span { color: var(--accent); }
  .family-note { padding-top: var(--space-lg); border-top: 1px solid rgba(255,255,255,0.28); }
  .family-note p { color: rgba(255,255,255,0.68); font-family: var(--font-editorial); font-size: 1.16rem; }
  .family-note strong { color: var(--paper-strong); }
  .family-note a { display: inline-flex; justify-content: space-between; gap: 24px; min-height: 44px; color: var(--trove); font-family: var(--font-label); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }

  .divisions { display: grid; margin-top: clamp(42px, 6vw, 68px); border-top: 1px solid rgba(255,255,255,0.45); }
  .division-card {
    display: grid;
    grid-template-columns: 44px minmax(120px, 0.45fr) minmax(240px, 0.9fr) minmax(300px, 1.35fr) minmax(160px, 0.55fr);
    gap: clamp(18px, 3vw, 42px);
    align-items: center;
    min-height: 138px;
    padding: 20px 22px;
    border-bottom: 1px solid rgba(255,255,255,0.45);
    transition: color 160ms ease, background 160ms ease;
  }
  .division-card > span, .division-card > p, .division-card > strong { font-family: var(--font-label); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  .division-card > span { color: var(--paper-strong); }
  .division-card > p { margin: 0; color: rgba(255,255,255,0.58); }
  .division-card h3 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 2.8vw, 3.25rem); letter-spacing: -0.07em; line-height: 0.88; overflow-wrap: anywhere; }
  .division-card small { color: rgba(255,255,255,0.65); font-size: 0.86rem; }
  .division-card > strong { display: flex; justify-content: space-between; gap: 18px; margin: 0; padding-bottom: 7px; border-bottom: 1px solid currentColor; }
  .division-card-1:hover, .division-card-1:focus-visible { color: var(--ink-deep); background: var(--reef); }
  .division-card-2:hover, .division-card-2:focus-visible { color: var(--ink-deep); background: var(--kyn); }
  .division-card-3:hover, .division-card-3:focus-visible { color: var(--ink-deep); background: var(--media); }
  .division-card-4:hover, .division-card-4:focus-visible { color: var(--ink-deep); background: var(--venture); }
  .division-card:hover > p, .division-card:focus-visible > p, .division-card:hover small, .division-card:focus-visible small { color: currentColor; }

  .research-note { padding: var(--section-space) var(--gutter); }
  .note-label { display: flex; justify-content: space-between; gap: 20px; padding-bottom: var(--space-sm); border-bottom: 1px solid var(--line-strong); color: var(--accent-dark); }
  .note-label p { margin: 0; }
  .research-note blockquote { max-width: 1060px; margin: clamp(36px, 5vw, 64px) 0 var(--space-lg); font-family: var(--font-editorial); font-size: var(--text-quote); letter-spacing: -0.04em; line-height: 1.04; }
  .note-credit { margin: 0; color: var(--ink-soft); }

  .people { padding: var(--section-space) var(--gutter); color: var(--paper-strong); background: #142430; }
  .section-heading.light .eyebrow { color: var(--kyn); }
  .section-heading.light > p { color: rgba(255,255,255,0.62); }
  .people-list { display: grid; gap: 1px; background: rgba(255,255,255,0.28); border: 1px solid rgba(255,255,255,0.28); }
  .person { display: grid; grid-template-columns: minmax(190px, 260px) minmax(0, 1fr); background: #142430; }
  .portrait { position: relative; padding: clamp(20px, 3vw, 36px); border-right: 1px solid rgba(255,255,255,0.28); }
  .portrait > span { position: absolute; z-index: 2; top: 14px; left: 14px; padding: 7px 9px; color: var(--ink-deep); background: var(--kyn); font-family: var(--font-label); font-size: 0.7rem; font-weight: 900; }
  .portrait img { width: 100%; aspect-ratio: 1; object-fit: cover; background: var(--paper); }
  .person-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(26px, 3vw, 46px); }
  .person-copy > p { margin-bottom: 12px; color: var(--kyn); }
  .person-copy h3 { margin: 0 0 16px; font-family: var(--font-display); font-size: var(--text-card); letter-spacing: -0.075em; line-height: 0.86; }
  .person-copy > strong { margin-bottom: var(--space-lg); color: rgba(255,255,255,0.62); }
  .person-copy > span { max-width: 790px; color: rgba(255,255,255,0.68); }

  @media (max-width: 980px) {
    .spotlight { grid-template-columns: 1fr 1fr; min-height: 440px; }
    .division-card { grid-template-columns: 36px minmax(0, 1fr) auto; gap: 12px 22px; align-items: start; padding-block: 24px; }
    .division-card > span { grid-row: 1 / 4; }
    .division-card > p, .division-card h3, .division-card small { grid-column: 2; }
    .division-card > strong { grid-column: 3; grid-row: 1 / 4; align-self: center; }
  }

  @media (max-width: 760px) {
    .hero-foot,
    .section-heading,
    .family-intro { grid-template-columns: 1fr; }
    .hero-actions { margin-top: 4px; }
    .spotlight,
    .release,

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ecosystem, leaders, projects } from "../data/site";

const featuredProjects = projects.filter((project) => project.featured);
const parentOrganization = ecosystem[0];
const operatingOrganizations = ecosystem.slice(1);
const activeProjectCount = projects.filter((project) => project.phase !== "past").length;
const archivedProjectCount = projects.filter((project) => project.phase === "past").length;
const toProjectId = (name: string) => `project-${name.toLowerCase().replaceAll(" ", "-")}`;
---

<BaseLayout
  title="Shwimp Studios | Software, tools, experiments"
  description="Shwimp Studios is an independent software studio and engineering lab building tools, experiments, and a strange little universe of named projects."
  canonicalPath="/"
>
  <main id="main-content">
    <section class="cover" id="index" aria-labelledby="cover-title">
      <div class="cover-inner">
        <div class="cover-copy">
          <div class="file-heading">
            <p>Public registry / Shwimp Studios</p>
            <span>File SS–001</span>
          </div>
          <p class="eyebrow">Independent software studio and engineering lab</p>
          <h1 id="cover-title">Useful software for curious people and questionable ideas.</h1>
          <p class="lede">
            Shwimp Studios is a small creative technology shop inside Lady International, organized around practical
            products, strange research threads, and a naming system that has already gone too far.
          </p>
          <div class="cover-actions" aria-label="Homepage shortcuts">
            <a class="action primary" href="#projects">Open project index</a>
            <a class="action secondary" href="#ecosystem">Trace the organization</a>
          </div>
        </div>

        <aside class="current-file" aria-labelledby="current-file-title">
          <div class="current-file-heading">
            <span>Current project / 001</span>
            <strong>{featuredProjects[0].status}</strong>
          </div>
          <div class="current-copy">
            <p>{featuredProjects[0].division}</p>
            <h2 id="current-file-title">{featuredProjects[0].name}</h2>
            <strong>{featuredProjects[0].kicker}</strong>
            <span>{featuredProjects[0].summary}</span>
          </div>
          <dl class="current-register">
            <div>
              <dt>Availability</dt>
              <dd>{featuredProjects[0].availability}</dd>
            </div>
            <div>
              <dt>Registry state</dt>
              <dd>Under development</dd>
            </div>
          </dl>
          <a class="current-link" href={`#${toProjectId(featuredProjects[0].name)}`}>
            Open project record <span aria-hidden="true">→</span>
          </a>
        </aside>
      </div>

      <dl class="cover-register" aria-label="Studio registry summary">
        <div>
          <dt>Parent organization</dt>
          <dd>Lady International</dd>
        </div>
        <div>
          <dt>Operating divisions</dt>
          <dd>{operatingOrganizations.length}</dd>
        </div>
        <div>
          <dt>Current records</dt>
          <dd>{activeProjectCount}</dd>
        </div>
        <div>
          <dt>Archived records</dt>
          <dd>{archivedProjectCount}</dd>
        </div>
      </dl>
    </section>

    <section class="project-index" id="projects" aria-labelledby="projects-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow">Selected works / register A</p>
          <h2 id="projects-title">The projects are the point.</h2>
        </div>
        <p>
          A working index of simulators, bookmark systems, developer tools, and retro-web experiments with enough
          personality to remember.
        </p>
      </div>

      <div class="project-ledger">
        {
          featuredProjects.map((project, index) => (
            <article id={toProjectId(project.name)} class={`project-record ${project.tone}`}>
              <div class="record-number" aria-hidden="true">A–{String(index + 1).padStart(2, "0")}</div>
              <div class="record-identity">
                <div class="project-topline">
                  <span>{project.division}</span>
                  <strong>{project.status}</strong>
                </div>
                <h3>{project.name}</h3>
                <p class="project-kicker">{project.kicker}</p>
              </div>
              <div class="record-detail">
                <p>{project.summary}</p>
                <div class="project-links" aria-label={`${project.name} links`}>
                  {project.links?.map((link) => (
                    <a href={link.href} target="_blank" rel="noopener noreferrer">
                      {link.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                  {project.availability && <span class="unavailable">{project.availability}</span>}
                </div>
              </div>
              <div class="record-initial" aria-hidden="true">{project.name.slice(0, 1)}</div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="organization-register" id="ecosystem" aria-labelledby="ecosystem-title">
      <div class="section-intro compact">
        <div>
          <p class="eyebrow">Corporate structure / register B</p>
          <h2 id="ecosystem-title">One parent. Four operating desks.</h2>
        </div>
        <p>Each name has a job. The projects make more sense when the structure is visible.</p>
      </div>

      <div class="organization-tree">
        <a class="parent-record" href={`/org/${parentOrganization.slug}/`}>
          <div>
            <p>{parentOrganization.role}</p>
            <h3>{parentOrganization.name}</h3>
          </div>
          <span>{parentOrganization.description}</span>
          <strong>Open parent file <b aria-hidden="true">→</b></strong>
        </a>

        <div class="branch-rule" aria-hidden="true"><span></span></div>

        <div class="operating-register">
          {
            operatingOrganizations.map((item, index) => (
              <a class="organization-record" href={`/org/${item.slug}/`}>
                <p>B–{String(index + 1).padStart(2, "0")} / {item.role}</p>
                <h3>{item.name}</h3>
                <span>{item.description}</span>
                <strong>View division <b aria-hidden="true">→</b></strong>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="personnel" id="studio" aria-labelledby="studio-title">
      <div class="section-intro personnel-heading">
        <div>
          <p class="eyebrow">Personnel files / register C</p>
          <h2 id="studio-title">Executive leadership for a very serious organization.</h2>
        </div>
        <p>
          A compact leadership structure with an unusually high tolerance for ideas that begin as jokes and become
          infrastructure.
        </p>
      </div>

      <div class="personnel-files">
        {
          leaders.map((leader, index) => (
            <article class="personnel-file">
              <div class="portrait-wrap">
                <p aria-hidden="true">C–{String(index + 1).padStart(2, "0")}</p>
                <picture>
                  <source
                    type="image/avif"
                    srcset={`${leader.image}-220.avif 220w, ${leader.image}-440.avif 440w`}
                    sizes="(max-width: 680px) 100vw, 260px"
                  />
                  <source
                    type="image/webp"
                    srcset={`${leader.image}-220.webp 220w, ${leader.image}-440.webp 440w`}
                    sizes="(max-width: 680px) 100vw, 260px"
                  />
                  <img
                    src={`${leader.image}-440.jpg`}
                    width="440"
                    height="440"
                    loading="lazy"
                    decoding="async"
                    alt={`Editorial portrait illustration of ${leader.name}.`}
                  />
                </picture>
              </div>
              <div class="personnel-copy">
                <p class="personnel-title">{leader.title}</p>
                <h3>{leader.name}</h3>
                <p class="personnel-alias">Known aliases: {leader.alias}</p>
                <p class="personnel-note">{leader.note}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .eyebrow,
  .file-heading,
  .project-topline,
  .record-number,
  .parent-record > div > p,
  .organization-record > p,
  .personnel-title,
  .portrait-wrap > p,
  .current-file-heading,
  .current-register,
  .current-copy > p {
    font-family: var(--font-label);
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .eyebrow {
    margin-bottom: var(--space-md);
    color: var(--signal);
    font-size: 0.78rem;
  }

  .cover {
    border-bottom: 1px solid var(--line-strong);
    background: var(--paper-light);
  }

  .cover-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(300px, 0.6fr);
    gap: clamp(48px, 8vw, 120px);
    align-items: center;
    width: min(100%, var(--max));
    min-height: calc(100svh - 74px - 106px);
    margin-inline: auto;
    padding: clamp(52px, 7vw, 90px) var(--gutter);
  }

  .file-heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: clamp(34px, 5vw, 64px);
    padding-bottom: var(--space-xs);
    border-bottom: var(--rule);
    color: var(--ink-soft);
    font-size: var(--text-label-small);
  }

  .file-heading p {
    margin: 0;
  }

  .cover h1 {
    max-width: 820px;
    margin-bottom: var(--space-md);
    font-size: clamp(3.25rem, 6.2vw, 6.8rem);
    font-weight: 700;
    line-height: 0.89;
  }

  .lede {
    max-width: 720px;
    margin-bottom: var(--space-lg);
    color: var(--ink-soft);
    font-size: clamp(1.03rem, 1.7vw, 1.28rem);
    line-height: 1.65;
  }

  .cover-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 10px 18px;
    border: 1px solid var(--ink-deep);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      color 140ms ease,
      background 140ms ease,
      transform 140ms ease;
  }

  .action:hover,
  .action:focus-visible {
    transform: translateY(-2px);
  }

  .action:active {
    transform: translateY(0);
  }

  .action.primary {
    color: var(--paper-strong);
    background: var(--ink-deep);
  }

  .action.primary:hover,
  .action.primary:focus-visible {
    background: var(--signal);
  }

  .action.secondary:hover,
  .action.secondary:focus-visible {
    color: var(--paper-strong);
    background: var(--ledger-green);
  }

  .current-file {
    position: relative;
    align-self: center;
    border-top: 2px solid var(--ink-deep);
    border-bottom: 1px solid var(--line-strong);
  }

  .current-file::before {
    position: absolute;
    top: -2px;
    bottom: -1px;
    left: 0;
    width: 4px;
    background: var(--signal);
    content: "";
  }

  .current-file-heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) 0 var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink-soft);
    font-size: var(--text-label-small);
  }

  .current-file-heading strong {
    color: var(--stamp);
  }

  .current-copy {
    padding: clamp(28px, 4vw, 48px) 0 clamp(26px, 4vw, 42px) var(--space-md);
  }

  .current-copy > p {
    margin-bottom: var(--space-xs);
    font-size: var(--text-label-small);
  }

  .current-copy h2 {
    margin-bottom: var(--space-xs);
    font-size: clamp(3.35rem, 5.5vw, 5.4rem);
    line-height: 0.86;
  }

  .current-copy > strong,
  .current-copy > span {
    display: block;
  }

  .current-copy > strong {
    margin-bottom: var(--space-sm);
    font-size: 0.93rem;
  }

  .current-copy > span {
    max-width: 38ch;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.58;
  }

  .current-register {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line-strong);
    font-size: var(--text-label-small);
  }

  .current-register div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-sm);
    min-width: 0;
    padding: var(--space-sm) var(--space-xs) var(--space-sm) var(--space-md);
  }

  .current-register div + div {
    border-top: 1px solid var(--line-strong);
  }

  .current-register dt {
    margin-bottom: 4px;
    color: var(--ink-soft);
  }

  .current-register dd {
    justify-self: end;
    margin: 0;
    color: var(--stamp);
    overflow-wrap: anywhere;
    text-align: right;
  }

  .current-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    padding: 10px var(--space-xs) 10px var(--space-md);
    border-top: 1px solid var(--line-strong);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .current-link span {
    color: var(--signal);
    font-size: 1rem;
    transition: transform 140ms ease;
  }

  .current-link:hover span,
  .current-link:focus-visible span {
    transform: translateX(4px);
  }

  .cover-register {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: min(100%, var(--max));
    margin: 0 auto;
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }

  .cover-register div {
    display: grid;
    gap: 2px;
    min-height: 106px;
    align-content: center;
    padding: var(--space-sm) var(--space-md);
    border-right: 1px solid var(--line-strong);
  }

  .cover-register dt {
    color: var(--ink-soft);
    font-family: var(--font-label);
    font-size: var(--text-label-small);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cover-register dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .project-index,
  .organization-register,
  .personnel {
    padding: var(--section-space) var(--gutter);
  }

  .section-intro,
  .project-ledger,
  .organization-tree,
  .personnel-files {
    width: min(100%, var(--max));
    margin-inline: auto;
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.55fr);
    gap: clamp(34px, 7vw, 96px);
    align-items: end;
    margin-bottom: clamp(38px, 6vw, 72px);
  }

  .section-intro h2 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2.9rem, 5.2vw, 5.8rem);
    font-weight: 700;
    line-height: 0.92;
  }

  .section-intro > p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }

  .project-index {
    background: var(--paper);
  }

  .project-ledger {
    border-top: 2px solid var(--ink-deep);
  }

  .project-record {
    --record-accent: var(--folder-blue);
    position: relative;
    display: grid;
    grid-template-columns: 80px minmax(220px, 0.85fr) minmax(300px, 1.15fr) 86px;
    gap: clamp(20px, 4vw, 58px);
    align-items: center;
    min-height: 230px;
    padding: clamp(28px, 4vw, 48px) var(--space-md);
    overflow: hidden;
    border-bottom: 1px solid var(--line-strong);
    transition: background 160ms ease;
  }

  .project-record.trove {
    --record-accent: color-mix(in srgb, var(--brass) 65%, var(--paper-light));
  }

  .project-record.kyn {
    --record-accent: color-mix(in srgb, var(--ledger-green) 58%, var(--paper-light));
  }

  .project-record.waves {
    --record-accent: color-mix(in srgb, var(--signal) 58%, var(--paper-light));
  }

  .project-record:hover {
    background: color-mix(in srgb, var(--record-accent) 16%, var(--paper));
  }

  .record-number {
    align-self: start;
    color: var(--signal);
    font-size: var(--text-label);
  }

  .project-topline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-md);
    color: var(--ink-soft);
    font-size: var(--text-label-small);
  }

  .project-topline strong {
    color: var(--stamp);
  }

  .record-identity h3 {
    margin-bottom: 4px;
    font-size: clamp(2.8rem, 4.8vw, 5.25rem);
    font-weight: 700;
    line-height: 0.88;
  }

  .project-kicker {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 800;
  }

  .record-detail > p {
    max-width: 570px;
    margin-bottom: var(--space-md);
    color: var(--ink-soft);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .project-links a,
  .project-links .unavailable {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 7px 11px;
    border: var(--rule);
    background: var(--paper-light);
    font-family: var(--font-label);
    font-size: var(--text-label-small);
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-links a {
    transition:
      color 140ms ease,
      background 140ms ease;
  }

  .project-links a:hover,
  .project-links a:focus-visible {
    color: var(--paper-strong);
    background: var(--ink-deep);
  }

  .project-links .unavailable {
    color: var(--ink-soft);
    background: transparent;
  }

  .record-initial {
    display: grid;
    width: 78px;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--record-accent);
    font-family: var(--font-display);
    font-size: 3.4rem;
    font-weight: 700;
  }

  .organization-register {
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    background: var(--paper-light);
  }

  .section-intro.compact h2 {
    max-width: 700px;
  }

  .organization-tree {
    max-width: 1080px;
  }

  .parent-record {
    display: grid;
    grid-template-columns: minmax(230px, 0.8fr) minmax(280px, 1.2fr) auto;
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-lg);
    border: 2px solid var(--ink-deep);
    color: var(--paper-strong);
    background: var(--ink-deep);
    transition: background 140ms ease;
  }

  .parent-record:hover,
  .parent-record:focus-visible {
    background: var(--ledger-green);
  }

  .parent-record > div > p,
  .organization-record > p {
    margin-bottom: var(--space-xs);
    color: var(--signal-light);
    font-size: var(--text-label-small);
  }

  .parent-record h3,
  .organization-record h3 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.8rem);
    font-weight: 700;
    line-height: 0.92;
  }

  .parent-record > span {
    color: color-mix(in srgb, var(--paper-light) 76%, transparent);
  }

  .parent-record > strong,
  .organization-record > strong {
    font-family: var(--font-label);
    font-size: var(--text-label-small);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .parent-record b,
  .organization-record b {
    color: var(--signal);
    font-size: 1rem;
  }

  .branch-rule {
    position: relative;
    width: calc(75% - var(--space-md));
    height: 54px;
    margin-inline: auto;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }

  .branch-rule::before {
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 100%;
    background: var(--line-strong);
    content: "";
  }

  .operating-register {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }

  .organization-record {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    min-width: 0;
    min-height: 330px;
    padding: var(--space-md);
    overflow: hidden;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    background: var(--paper-strong);
    transition:
      color 140ms ease,
      background 140ms ease;
  }

  .organization-record:nth-child(2) {
    background: color-mix(in srgb, var(--folder-blue) 30%, var(--paper-strong));
  }

  .organization-record:nth-child(3) {
    background: color-mix(in srgb, var(--signal) 10%, var(--paper-strong));
  }

  .organization-record:nth-child(4) {
    background: color-mix(in srgb, var(--brass) 22%, var(--paper-strong));
  }

  .organization-record:hover,
  .organization-record:focus-visible {
    color: var(--paper-strong);
    background: var(--ink-deep);
  }

  .organization-record h3 {
    max-width: 100%;
    margin-bottom: var(--space-md);
    font-size: clamp(2rem, 2.4vw, 2.55rem);
    line-height: 0.96;
  }

  .organization-record > span {
    color: var(--ink-soft);
    font-size: 0.96rem;
  }

  .organization-record:hover > span,
  .organization-record:focus-visible > span {
    color: color-mix(in srgb, var(--paper-light) 76%, transparent);
  }

  .organization-record > strong {
    align-self: end;
    justify-self: start;
    margin-top: var(--space-md);
  }

  .personnel {
    color: var(--paper-light);
    background: var(--ink-deep);
  }

  .personnel-heading .eyebrow {
    color: var(--signal-light);
  }

  .personnel-heading > p {
    color: color-mix(in srgb, var(--paper-light) 66%, transparent);
  }

  .personnel-files {
    border-top: 1px solid color-mix(in srgb, var(--paper-light) 30%, transparent);
  }

  .personnel-file {
    position: relative;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(28px, 4vw, 52px);

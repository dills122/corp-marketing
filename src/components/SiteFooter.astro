---
import { ecosystem } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-lead">
      <p>Shwimp Studios · Independent software label</p>
      <h2>Useful products.<br />Strange research.<br /><span>Properly named.</span></h2>
    </div>

    <div class="footer-columns">
      <nav aria-label="Footer site navigation">
        <p>Browse</p>
        <a href="/">Home</a>
        <a href="/#projects">Releases</a>
        <a href="/org/">Organizations</a>
        <a href="/#studio">People</a>
      </nav>

      <nav aria-label="Footer organization navigation">
        <p>Label family</p>
        {ecosystem.map((org) => <a href={`/org/${org.slug}/`}>{org.name}</a>)}
      </nav>

      <nav aria-label="External channels">
        <p>Elsewhere</p>
        <a href="https://github.com/dills122" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/dssteele122/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href="https://dsteele.dev/" target="_blank" rel="noopener noreferrer">dsteele.dev ↗</a>
        <a href="https://github.com/dills122/corp-marketing" target="_blank" rel="noopener noreferrer">Site source ↗</a>
      </nav>
    </div>

    <div class="footer-base">
      <span>An operating division of Lady International</span>
      <span>&copy; {year} Shwimp Studios</span>
      <a href="#main-content">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    color: var(--paper-strong);
    background: var(--accent);
  }

  .footer-inner {
    width: min(100%, var(--max));
    margin-inline: auto;
    padding: clamp(54px, 7vw, 92px) var(--gutter) 26px;
  }

  .footer-lead {
    display: grid;
    grid-template-columns: minmax(200px, 0.45fr) minmax(0, 1.55fr);
    gap: clamp(32px, 7vw, 100px);
    padding-bottom: clamp(42px, 6vw, 72px);
  }

  .footer-lead p,
  .footer-columns p,
  .footer-columns a,
  .footer-base {
    font-family: var(--font-label);
    font-size: 0.69rem;
    font-weight: 800;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .footer-lead p {
    margin: 0;
  }

  .footer-lead h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-feature);
    letter-spacing: -0.075em;
    line-height: 0.82;
  }

  .footer-lead h2 span {
    color: var(--ink-deep);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(30px, 7vw, 100px);
    margin-left: max(0px, calc(25% + 20px));
    padding-block: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.58);
  }

  .footer-columns nav {
    display: grid;
    align-content: start;
  }

  .footer-columns p {
    margin: 0 0 var(--space-sm);
    color: var(--ink-deep);
  }

  .footer-columns a {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 36px;
    transition: color 140ms ease, transform 140ms ease;
  }

  .footer-columns a:hover,
  .footer-columns a:focus-visible {
    color: var(--ink-deep);
    transform: translateX(3px);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 28px;
    margin-top: var(--space-lg);
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.58);
  }

  .footer-base a:hover,
  .footer-base a:focus-visible {
    color: var(--ink-deep);
  }

  @media (max-width: 760px) {
    .footer-lead {
      grid-template-columns: 1fr;
    }

    .footer-columns {
      margin-left: 0;
    }
  }

  @media (max-width: 540px) {
    .footer-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-columns nav:last-child {
      grid-column: 1 / -1;
    }

    .footer-base {
      justify-content: flex-start;
    }
  }
</style>

---
import { projects } from "../data/site";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isOpenSource = currentPath.startsWith("/open-source/");
const isProjects = currentPath.startsWith("/projects/");
const navigation = [
  { label: "Featured", href: "/#projects", current: false },
  { label: "Projects", href: "/projects/", current: isProjects },
  { label: "Open source", href: "/open-source/", current: isOpenSource },
  { label: "Studio", href: "/#ecosystem", current: false },
  { label: "People", href: "/#studio", current: false },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Shwimp Studios home">
      <span class="brand-monogram" aria-hidden="true">SS</span>
      <span class="brand-copy">
        <strong>Shwimp Studios</strong>
        <small>Independent software studio</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((link) => (
        <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>

    <details class="mobile-menu">
      <summary>Menu <span aria-hidden="true">+</span></summary>
      <nav aria-label="Primary navigation">
        {navigation.map((link) => (
          <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
        ))}
      </nav>
    </details>

    <a class="edition" href="/projects/" aria-current={isProjects ? "page" : undefined}>
      <span>Projects</span>
      <strong>{projects.length}</strong>
    </a>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
  const summary = menu?.querySelector("summary");

  menu?.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !menu.open) return;
    menu.open = false;
    summary?.focus();
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.open = false;
      // Keep focus visible until the browser follows the page or fragment link.
      summary?.focus();
    });
  });

  document.addEventListener("click", (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) {
      menu.open = false;
    }
  });

  menu?.addEventListener("focusout", (event) => {
    if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) {
      menu.open = false;
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) auto 72px;
    gap: clamp(18px, 3vw, 48px);
    align-items: stretch;
    width: min(100%, var(--max));
    min-height: 77px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: inline-flex;
    gap: 13px;
    align-items: center;
    min-height: 56px;
    width: fit-content;
  }

  .brand-monogram {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    color: var(--paper-strong);
    background: var(--ink-deep);
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: -0.08em;
    transition: color var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard), transform var(--motion-base) var(--ease-out);
  }

  .brand:hover .brand-monogram,
  .brand:focus-visible .brand-monogram {
    color: var(--ink-deep);
    background: var(--accent);
    transform: rotate(-2deg) scale(1.035);
  }

  .brand-copy {
    display: grid;
    line-height: 1.05;
  }

  .brand-copy strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.04em;
  }

  .brand-copy small,
  nav a,
  .mobile-menu summary,
  .edition {
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .brand-copy small {
    margin-top: 5px;
    color: var(--accent-dark);
  }

  nav {
    display: flex;
    align-items: stretch;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 10px 13px;
    border-bottom: 4px solid transparent;
    color: var(--ink-soft);
    transition: color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard);
  }

  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current] {
    border-bottom-color: var(--accent);
    color: var(--ink-deep);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .edition {
    display: grid;
    align-content: center;
    justify-items: end;
    border-left: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .edition strong {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .edition:hover strong,
  .edition:focus-visible strong { transform: translateY(-2px); }

  .mobile-menu { display: none; }

  @media (max-width: 920px) {
    .header-inner {
      grid-template-columns: minmax(210px, 1fr) auto;
    }

    .edition {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px;
      min-height: 62px;
      padding-inline: 12px;
    }

    .brand {
      gap: 9px;
      min-height: 62px;
    }

    .brand-monogram { width: 38px; height: 38px; }
    .brand-copy strong { font-size: 0.92rem; }
    .brand-copy small { display: none; }

    .desktop-nav { display: none; }
    .mobile-menu { display: block; align-self: center; }
    .mobile-menu summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-height: 44px;
      padding: 8px 12px;
      border: 1px solid var(--line-strong);
      list-style: none;
      cursor: pointer;
    }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu summary span { font-size: 1.1rem; }
    .mobile-menu[open] summary span { transform: rotate(45deg); }
    .mobile-menu summary:hover,
    .mobile-menu[open] summary { background: var(--reef); }
    .mobile-menu nav {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: flex;
      flex-direction: column;
      max-height: calc(100dvh - 64px);
      overflow-y: auto;
      padding: 12px;
      background: var(--paper);
      border-bottom: 1px solid var(--line-strong);
      box-shadow: 0 12px 20px rgba(12, 21, 28, 0.12);
    }
    .mobile-menu nav a { min-height: 48px; font-size: 0.8rem; }
  }
</style>

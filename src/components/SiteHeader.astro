---
import { projects } from "../data/site";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isProjects = currentPath.startsWith("/projects/");
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Shwimp Studios home">
      <span class="brand-monogram" aria-hidden="true">SS</span>
      <span class="brand-copy">
        <strong>Shwimp Studios</strong>
        <small>Independent software studio</small>
      </span>
    </a>

    <nav aria-label="Primary navigation">
      <a href="/#projects" data-nav-section="projects">Featured</a>
      <a href="/projects/" aria-current={isProjects ? "page" : undefined}>Projects</a>
      <a href="/#ecosystem" data-nav-section="ecosystem">Studio</a>
      <a href="/#studio" data-nav-section="studio">People</a>
    </nav>

    <a class="edition" href="/projects/" aria-current={isProjects ? "page" : undefined}>
      <span>Projects</span>
      <strong>{projects.length}</strong>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) auto 72px;
    gap: clamp(18px, 3vw, 48px);
    align-items: stretch;
    width: min(100%, var(--max));
    min-height: 77px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: inline-flex;
    gap: 13px;
    align-items: center;
    min-height: 56px;
    width: fit-content;
  }

  .brand-monogram {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    color: var(--paper-strong);
    background: var(--ink-deep);
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: -0.08em;
    transition: color var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard), transform var(--motion-base) var(--ease-out);
  }

  .brand:hover .brand-monogram,
  .brand:focus-visible .brand-monogram {
    color: var(--ink-deep);
    background: var(--accent);
    transform: rotate(-2deg) scale(1.035);
  }

  .brand-copy {
    display: grid;
    line-height: 1.05;
  }

  .brand-copy strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.04em;
  }

  .brand-copy small,
  nav a,
  .edition {
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .brand-copy small {
    margin-top: 5px;
    color: var(--accent-dark);
  }

  nav {
    display: flex;
    align-items: stretch;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 10px 13px;
    border-bottom: 4px solid transparent;
    color: var(--ink-soft);
    transition: color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard);
  }

  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current] {
    border-bottom-color: var(--accent);
    color: var(--ink-deep);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .edition {
    display: grid;
    align-content: center;
    justify-items: end;
    border-left: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .edition strong {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .edition:hover strong,
  .edition:focus-visible strong { transform: translateY(-2px); }

  @media (max-width: 920px) {
    .header-inner {
      grid-template-columns: minmax(210px, 1fr) auto;
    }

    .edition {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .header-inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 10px;
      min-height: 62px;
      padding-inline: 12px 6px;
    }

    .brand {
      gap: 9px;
      min-height: 62px;
    }

    .brand-monogram { width: 38px; height: 38px; }
    .brand-copy strong { font-size: 0.92rem; }
    .brand-copy small { display: none; }

    nav {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }

    nav::-webkit-scrollbar {
      display: none;
    }

    nav a {
      flex: 0 0 auto;
      justify-content: center;
      min-height: 62px;
      padding-inline: 9px;
    }
  }

  @media (max-width: 420px) {
    .brand-copy { display: none; }

    nav a {
      font-size: 0.58rem;
      padding-inline: 8px;
    }
  }
</style>

---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isHome = currentPath === "/";
const isOrganizations = currentPath.startsWith("/org/");
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand-mark" href="/" aria-label="Shwimp Studios home">
      <span class="brand-seal" aria-hidden="true">LI</span>
      <span class="brand-copy">
        <small>Lady International registry</small>
        <strong>Shwimp Studios</strong>
      </span>
    </a>

    <p class="registry-code" aria-hidden="true">Public file / SS–001</p>

    <nav aria-label="Primary navigation">
      <a href="/" data-nav-section="index" aria-current={isHome ? "page" : undefined}>Index</a>
      <a href="/#projects" data-nav-section="projects">Projects</a>
      <a href="/org/" data-nav-section="ecosystem" aria-current={isOrganizations ? "page" : undefined}>
        Organizations
      </a>
      <a href="/#studio" data-nav-section="studio">Personnel</a>
    </nav>
  </div>
</header>

<script>
  const updateHomeNavigation = () => {
    if (window.location.pathname !== "/") return;

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-section]"));
    const sections = ["index", "projects", "ecosystem", "studio"]
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => section instanceof HTMLElement);
    const header = document.querySelector<HTMLElement>(".site-header");
    const probe = window.scrollY + (header?.offsetHeight ?? 0) + window.innerHeight * 0.18;
    let activeSection = sections[0]?.id ?? "index";

    for (const section of sections) {
      if (section.offsetTop <= probe) activeSection = section.id;
    }

    if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
      activeSection = sections.at(-1)?.id ?? activeSection;
    }

    for (const link of links) {
      if (link.dataset.navSection === activeSection) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    }
  };

  let navigationFrame = 0;
  const requestNavigationUpdate = () => {
    if (navigationFrame) return;

    navigationFrame = window.requestAnimationFrame(() => {
      navigationFrame = 0;
      updateHomeNavigation();
    });
  };

  updateHomeNavigation();
  window.addEventListener("scroll", requestNavigationUpdate, { passive: true });
  window.addEventListener("resize", requestNavigationUpdate);
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    width: 100%;
    border-bottom: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--paper-light) 95%, transparent);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(18px, 3vw, 42px);
    align-items: center;
    width: min(100%, var(--max));
    min-height: 74px;
    margin-inline: auto;
    padding: 10px var(--gutter);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    min-width: 0;
  }

  .brand-seal {
    display: grid;
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--ink-deep);
    color: var(--paper-strong);
    background: var(--ink-deep);
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.03em;
  }

  .brand-copy {
    display: grid;
    line-height: 1;
  }

  .brand-copy small,
  .registry-code,
  nav a {
    font-family: var(--font-label);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .brand-copy small {
    margin-bottom: 4px;
    color: var(--signal);
    font-size: var(--text-label-small);
  }

  .brand-copy strong {
    font-family: var(--font-display);
    font-size: 1.12rem;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .registry-code {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--text-label-small);
  }

  nav {
    display: flex;
    justify-content: flex-end;
    gap: 2px;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 10px;
    border-bottom: 2px solid transparent;
    color: var(--ink-soft);
    font-size: var(--text-label);
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background 140ms ease;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current] {
    border-bottom-color: var(--signal);
    color: var(--ink-deep);
    background: color-mix(in srgb, var(--signal) 6%, transparent);
  }

  nav a:active {
    color: var(--signal);
  }

  @media (max-width: 900px) {
    .registry-code {
      display: none;
    }

    .header-inner {
      grid-template-columns: auto 1fr;
    }
  }

  @media (max-width: 680px) {
    .header-inner {
      grid-template-columns: 1fr;
      gap: 7px;
      padding-inline: 12px;
      padding-top: 9px;
      padding-bottom: 0;
    }

    .brand-mark {
      justify-self: start;
    }

    .brand-seal {
      width: 36px;
      height: 36px;
    }

    .brand-copy small {
      font-size: 0.65rem;
    }

    .brand-copy strong {
      font-size: 1rem;
    }

    nav {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      justify-content: stretch;
      border-top: var(--rule);
    }

    nav a {
      justify-content: center;
      min-width: 0;
      padding-inline: 3px;
      font-size: clamp(0.65rem, 2.9vw, 0.72rem);
      letter-spacing: 0.02em;
    }
  }
</style>

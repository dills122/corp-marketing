---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isOrganizations = currentPath.startsWith("/org/");
---

<header class="site-header">
  <a class="brand-mark" href="/" aria-label="Shwimp Studios home">
    <span class="brand-glyph" aria-hidden="true">SS</span>
    <span>
      <strong>Shwimp Studios</strong>
      <small>Lady International</small>
    </span>
  </a>
  <nav aria-label="Primary navigation">
    <a href="/org/" aria-current={isOrganizations ? "page" : undefined}>Organizations</a>
    <a href="/#projects">Projects</a>
    <a href="/#studio">Studio</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    padding: 14px max(18px, calc((100vw - var(--max)) / 2));
    border-bottom: 1px solid var(--line);
    background: rgba(251, 244, 231, 0.9);
    backdrop-filter: blur(18px);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .brand-mark strong,
  .brand-mark small {
    display: block;
    white-space: nowrap;
  }

  .brand-mark strong {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.1rem;
    line-height: 1.05;
  }

  .brand-mark small {
    color: var(--ink-soft);
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .brand-glyph {
    display: grid;
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    color: var(--paper-strong);
    background: var(--ink);
    font-size: 0.78rem;
    font-weight: 900;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 10px;
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.88rem;
    font-weight: 800;
    transition:
      color 160ms ease,
      background 160ms ease;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current="page"] {
    color: var(--ink);
    background: rgba(33, 79, 111, 0.1);
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      padding-inline: 12px;
    }

    nav {
      justify-content: flex-end;
      gap: 2px;
    }

    nav a {
      padding-inline: 7px;
      font-size: 0.76rem;
    }

    .brand-mark small {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .site-header {
      gap: 8px;
    }

    .brand-mark {
      gap: 6px;
    }

    .brand-mark strong {
      max-width: 78px;
      white-space: normal;
      font-size: 0.84rem;
    }

    .brand-glyph {
      width: 32px;
      height: 32px;
    }

    nav a {
      padding-inline: 4px;
      font-size: 0.7rem;
    }
  }
</style>
